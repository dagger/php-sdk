"""
A Dagger module that uses the PHP SDK.
"""
type Mod {
  """
  Workspace-root-relative path of this module root. This stable identity is
  independent of the client's cwd.
  """
  pub rootPath: String!

  """
  The workspace this module belongs to.
  """
  let ws: Workspace!

  """
  Marker filename that skips generate when found at or above this module root.
  """
  let skipGenerateFilename: String!

  """
  The engine version the module's client, schema and dang.toml all target.
  """
  let targetEngineVersion: String!

  """
  Whether the manifest declares an engineVersion later than the release this SDK
  generates for. Such a module is not migrated: migration would silently drop a
  version that this SDK cannot generate for. A module already on the generated entrypoint
  is not refused: the engine takes its version from dang.toml and ignores the
  manifest's engineVersion (dagger/dagger v1.0.0-beta.27,
  resolveModuleSourceVersions).
  """
  let declaresLaterEngine: Boolean!

  """
  The module name the caller knows, empty to read it from the manifest.
  """
  let givenName: String!

  """
  The init template under templates/ that seeds a module without composer.json.
  """
  let templateName: String!

  """
  The modules the scope declares as clients, as the engine loaded them. Null when
  the caller does not know them, as a direct mod call does not.
  """
  let clients: [ModuleSource!]

  let phpImage: String! = "php:8.4-cli-alpine@sha256:ef24d42ed7297dc8c9a6672988594c5f18702a434b3af48a3128fed8d2569746"
  let composerImage: String! = "composer/composer:2.8-bin@sha256:c735b6a52ea118693178babc601984dbbbd07f1d31ec87eaa881173622b467ed"
  let entrypointPath: String! = "sdk/entrypoint"

  """
  Module root relative to the client's cwd.
  """
  pub path: String! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (rootPath == cwd) {
      "."
    } else if (cwd == "") {
      rootPath
    } else if (rootPath.trimPrefix(cwd + "/") != rootPath) {
      rootPath.trimPrefix(cwd + "/")
    } else if (rootPath == "." or cwd.trimPrefix(rootPath + "/") != cwd) {
      let depth = if (rootPath == ".") { 0 } else { rootPath.split("/").length }
      cwd.split("/").dropFirst(depth).map { segment => ".." }.join("/")
    } else {
      rootPath
    }
  }

  """
  Whether this module or an ancestor contains the configured generate skip marker.
  """
  pub skipGenerate: Boolean! {
    ws.findUp(name: skipGenerateFilename, from: moduleRef) != null
  }

  """
  Generate this module.
  If the generate skip marker is present, the changeset is empty.
  """
  pub generate: Changeset! {
    if (skipGenerate) {
      changeset
    } else {
      if (usesEntrypoint) {
        let cwd = ws.cwd.trimPrefix("/")
        entrypointGenerated.withWorkdir(if (cwd == "") { "." } else { cwd }).changes(ws)
      } else {
        legacyChanges
      }
    }
  }

  """
  The workspace with this module generated, at the workspace root.
  """
  pub generated: Workspace! {
    if (skipGenerate) {
      ws.withWorkdir(".")
    } else if (usesEntrypoint) {
      entrypointGenerated
    } else {
      ws.withChanges(legacyChanges).withWorkdir(".")
    }
  }

  """
  Whether generation writes the entrypoint this SDK owns. A module with an
  entrypoint of its own, a runtime other than PHP's, or a configuration the
  entrypoint cannot preserve keeps the path the engine drives. The engine reads
  a manifest with an entrypoint, dependencies and a runtime as a runtime
  manifest, and refuses one without the runtime.
  """
  pub usesEntrypoint: Boolean! {
    if (hasEntrypoint) {
      if (ownsEntrypoint == false) {
        false
      } else if (declares("dependencies")) {
        if (runtimeSource == "") {
          raise "module at " + rootPath + " has an entrypoint and dependencies without a runtime, and an entrypoint has no dependency list: restore [runtime] source = \"php\" to keep the dependencies, or remove them"
        }
        false
      } else if (entrypointBlockers.length > 0) {
        raise "module at " + rootPath + " cannot keep its generated entrypoint: " + entrypointBlockers.join("; ")
      } else {
        true
      }
    } else if (runtimeSource != "php") {
      false
    } else {
      declares("dependencies") == false and declaresLaterEngine == false and entrypointBlockers.length == 0
    }
  }

  """
  Whether the manifest names the entrypoint this SDK writes, and the entrypoint
  is one this SDK wrote. Other SDKs write to the same path, so the path alone
  does not tell.
  """
  pub ownsEntrypoint: Boolean! {
    if (hasEntrypoint == false or fileExists(entrypointPath + "/build.dang") == false) {
      false
    } else {
      let entrypoint = manifest.field(["entrypoint"])
      stringField(entrypoint, "kind") == "dang" and
        stringField(entrypoint, "source").trimPrefix("./").trimSuffix("/") == entrypointPath and
        contentsOf(entrypointPath + "/build.dang").contains("type PhpModuleBuild")
    }
  }

  """
  The schema of the target engine version, which the client is generated from.
  A manifest on the Dang runtime asks the engine for that view, whatever the
  module's own manifest declares, and without dependencies.
  """
  pub clientSchema: File! {
    let rooted = ws.withWorkdir(".")
    sdkHelpers.moduleManifest
      .withName(name: moduleName)
      .withLegacyDangRuntime(engineVersion: targetEngineVersion)
      .generate(rooted.withWorkdir(rootPath), lock: false, legacyJson: false)
      .withWorkdir(".")
      .moduleSource(moduleRef)
      .introspectionSchemaJSON
  }

  """
  A PHP container with Composer, as module calls run in.
  """
  pub phpContainer: Container! {
    container
      .from(phpImage)
      .withExec(["apk", "add", "git", "openssh", "curl"])
      .withFile("/usr/bin/composer", container.from(composerImage).file("/composer"))
      .withMountedCache("/root/.composer", cacheVolume("composer-" + phpImage))
      .withEnvVariable("COMPOSER_HOME", "/root/.composer")
      .withEnvVariable("COMPOSER_NO_INTERACTION", "1")
      .withEnvVariable("COMPOSER_ALLOW_SUPERUSER", "1")
  }

  let entrypointGenerated: Workspace! {
    checkConfig
    checkSdkOwned
    checkClients
    let sdk = sdkTree
    let describing = sourceWithSdk(sdk)
      .withExec(composerCommand)
      .withEnvVariable("DAGGER_CLIENT_VERSION", targetEngineVersion)
      .withExec(
        ["php", "sdk/bin/dagger-module", "generate", "--name", moduleName, "--client-version", targetEngineVersion, "--output", "/dagger/entrypoint"],
        experimentalPrivilegedNesting: true,
      )
    let entrypoint = describing.directory("/dagger/entrypoint").withNewFile("build.dang", buildDang)
    let written = withoutSdk
      .withDirectory(modulePath("sdk"), sdk.withDirectory("entrypoint", entrypoint))
      .withNewFile(modulePath("composer.lock"), describing.file("/src/composer.lock").contents, permissions: 420)
    withGitVisibility(withManifest(withConfig(written)))
  }

  """
  The templateName template rendered with the module name. A module without
  composer.json gets the files of it that it does not have, as the engine's PHP
  runtime seeds such a module.
  """
  let renderedTemplate: Directory! {
    if (currentModule.source.exists("templates/" + templateName) == false) {
      raise "unknown init template: " + templateName
    }
    container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helper", currentModule.source.directory("helpers/render-template"))
      .withDirectory("/template", currentModule.source.directory("templates/" + templateName))
      .withWorkdir("/helper")
      .withExec(["go", "build", "-o", "/usr/local/bin/render-template", "."])
      .withExec(["render-template", moduleName, "/template", "/rendered"])
      .directory("/rendered")
  }

  """
  The workspace at its root. A module without composer.json gets the files of the
  templateName template that it does not have.
  """
  let seeded: Workspace! {
    let current = ws.withWorkdir(".")
    if (fileExists("composer.json")) {
      current
    } else {
      current.withDirectory(rootPath, renderedTemplate.withDirectory(".", current.directory(rootPath)))
    }
  }

  """
  The workspace with this PHP program's clients generated into its sdk/, at the
  workspace root. A program is a scope without a module: its composer.json gets
  the path repository ./sdk and requires dagger/dagger, and its composer.lock
  follows. A program without clients is left as it is, unless this SDK wrote its
  sdk/, which is then regenerated without them.
  """
  pub programGenerated: Workspace! {
    let hasComposer = fileExists("composer.json")
    let nothingToWrite = knownClients.length == 0 and (hasComposer == false or ownsSdk == false)
    if (skipGenerate or nothingToWrite) {
      return ws.withWorkdir(".")
    }
    if (hasComposer == false) {
      raise label + " has no composer.json, which autoloads its clients: create one with composer init, or remove the clients " + knownClients.map { client => client.moduleName }.join(", ")
    }
    let keyTaken = toString(parsedJson(contentsOf("composer.json")).field(["repositories", "dagger-sdk"]).contents) rescue {
      err: Error => ""
    }
    if (usesSdkRepository == false and keyTaken != "") {
      raise label + " names a Composer repository dagger-sdk, which composer config would replace with ./sdk: rename it"
    }
    checkSdkOwned
    checkClients
    let sdk = sdkTree
    let source = sourceWithSdk(sdk)
    let repository = if (usesSdkRepository) { source } else { source.withExec(["composer", "config", "repositories.dagger-sdk", "path", "./sdk"]) }
    let wired = repository
      .withExec(["composer", "require", "--no-update", "dagger/dagger:*@dev"])
      .withExec(composerCommand)
    let lock = wired.file("/src/composer.lock").contents
    if (lock.containsMatch(Regexp(sdkLockPattern)) == false) {
      raise label + " has a Composer repository that provides dagger/dagger in place of ./sdk, which holds its clients: remove that repository, or the filters on ./sdk"
    }
    withoutSdk
      .withDirectory(modulePath("sdk"), sdk)
      .withNewFile(modulePath("composer.json"), wired.file("/src/composer.json").contents, permissions: 420)
      .withNewFile(modulePath("composer.lock"), lock, permissions: 420)
  }

  """
  dagger/dagger in a composer.lock, installed from the path repository ./sdk.
  """
  let sdkLockPattern: String! = "\"name\": \"dagger/dagger\",[^}]*\"dist\": \\{\\s*\"type\": \"path\",\\s*\"url\": \"(\\./)?sdk/?\""

  let sourceWithSdk(sdk: Directory!): Container! {
    phpContainer
      .withDirectory("/src", seeded.directory(rootPath, exclude: [".git", "vendor", "sdk"], gitignore: true))
      .withDirectory("/src/sdk", sdk)
      .withWorkdir("/src")
  }

  """
  Generated files are replaced whole: merging would keep client classes the
  target schema no longer has.
  """
  let withoutSdk: Workspace! {
    if (fileExists("sdk")) { seeded.withoutDirectory(modulePath("sdk")) } else { seeded }
  }

  """
  What a refusal names: the module, or the PHP program of a scope without one.
  """
  let label: String! {
    if (fileExists("dagger-module.toml") or fileExists("dagger.json")) { "module at " + rootPath } else { "PHP program at " + rootPath }
  }

  """
  The SDK library with its client and its module clients generated, without what
  only generation needs. Each client's schema is read in the target view, as
  the core schema is.
  """
  let sdkTree: Directory! {
    let core = phpContainer
      .withDirectory(
        "/sdk",
        currentModule.source.directory("sdk"),
        include: ["src/**", "scripts/**", "bin/**", "composer.json", "composer.lock", "LICENSE"],
      )
      .withWorkdir("/sdk")
      .withExec(["composer", "install", "--no-dev"])
      .withMountedFile("/schema.json", clientSchema)
      .withExec(["php", "scripts/codegen.php", "dagger:codegen", "--schema-file", "/schema.json"])
    let generated = knownClients.reduce(core) { ctr, client =>
      let pin = if (client.kind == ModuleSourceKind.GIT_SOURCE) { ["--pin", client.pin] } else { [] :: [String!]! }
      ctr
        .withMountedFile("/client-schema.json", client.withEngineVersion(targetEngineVersion).clientSchemaIntrospectionJSON)
        .withExec(["php", "scripts/codegen.php", "dagger:codegen", "--schema-file", "/client-schema.json", "--client", client.moduleName, "--address", clientAddress(client)] + pin)
    }
    generated
      .directory("/sdk")
      .withoutDirectory("vendor")
      .withoutDirectory("scripts")
      .withoutFile("composer.lock")
      .withNewFile(".gitattributes", "** linguist-generated\n")
  }

  let composerCommand: [String!]! {
    if (fileExists("composer.lock")) {
      ["composer", "update", "--with-all-dependencies", "--minimal-changes", "dagger/dagger"]
    } else {
      ["composer", "install"]
    }
  }

  let buildDang: String! {
    currentModule.source.file("entrypoint/build.dang.tmpl").contents
      .replaceMatches("@PHP_IMAGE@", phpImage)
      .replaceMatches("@COMPOSER_IMAGE@", composerImage)
  }

  """
  Write sdk/entrypoint/dang.toml. The loaded file is written back into the new
  entrypoint first: replacing sdk/ removed it, and the helper reads what the
  workspace holds at its cwd.
  """
  let withConfig(target: Workspace!): Workspace! {
    let leaf = modulePath(entrypointPath + "/dang.toml")
    let restored = if (fileExists(entrypointPath + "/dang.toml")) {
      target.withNewFile(leaf, contentsOf(entrypointPath + "/dang.toml"), permissions: 420)
    } else {
      target
    }
    let keptAncestor = if (fileExists("sdk/dang.toml")) {
      restored.withNewFile(modulePath("sdk/dang.toml"), contentsOf("sdk/dang.toml"), permissions: 420)
    } else {
      restored
    }
    let entrypointDir = keptAncestor.withWorkdir(modulePath(entrypointPath))
    sdkHelpers.loadDangConfig(entrypointDir)
      .withVersion("2.1")
      .withDaggerImport(name: "Dagger", version: targetEngineVersion)
      .generate(entrypointDir)
      .withWorkdir(".")
  }

  """
  A module migrating from the runtime loses what only a runtime reads. A module
  already on the entrypoint keeps a runtime it names for older engines, which
  read such a manifest as a runtime manifest.
  """
  let withManifest(target: Workspace!): Workspace! {
    let loaded = sdkHelpers.loadModuleManifest(ws.withWorkdir(".").withWorkdir(rootPath))
    let base = if (hasEntrypoint) { loaded } else { loaded.withoutLegacyFields }
    base
      .withName(name: moduleName)
      .withDangEntrypoint(source: "./" + entrypointPath)
      .generate(target.withWorkdir(rootPath), lock: false, legacyJson: false)
      .withWorkdir(".")
  }

  """
  The engine reads an entrypoint from a module's files, which .gitignore filters.
  Any rule can match a file under sdk/, such as /sdk/generated/ or bin/, so unless
  only vendor rules follow a re-inclusion of both sdk/ and its contents, it is
  appended again: Git cannot re-include a file while its parent stays excluded. A
  later rule overrides an earlier one, so the user's rules stay as they are. Only
  this file is read: an ignore rule above the module still applies, as the README
  says.
  """
  let withGitVisibility(target: Workspace!): Workspace! {
    let existing = if (fileExists(".gitignore")) { contentsOf(".gitignore") } else { "" }
    let lines = existing.split("\n")
      .map { line => line.trimSpace }
      .filter { line => line != "" and line.hasPrefix("#") == false }
    let vendorRules = ["vendor", "/vendor", "vendor/", "/vendor/"]
    let rulesAfterInclusion = lines.reduce([] :: [String!]!) { rules, line =>
      if (line == "!/sdk/**" and rules.length > 0 and (rules[rules.length - 1] ?? "") == "!/sdk/") {
        [] :: [String!]!
      } else {
        rules + [line]
      }
    }
    let sdkMayBeHidden = rulesAfterInclusion.filter { line => vendorRules.contains(line) == false }.length > 0
    let vendorIgnored = lines.filter { line => vendorRules.contains(line) }.length > 0
    let added = (if (vendorIgnored) { "" } else { "/vendor/\n" }) + (if (sdkMayBeHidden) { "!/sdk/\n!/sdk/**\n" } else { "" })
    if (added == "") {
      target
    } else {
      let separator = if (existing == "" or existing.hasSuffix("\n")) { "" } else { "\n" }
      target.withNewFile(modulePath(".gitignore"), existing + separator + added, permissions: 420)
    }
  }

  """
  Refuse a dang.toml the generated entrypoint would change or hide without saying
  so. A dang.toml in the entrypoint directory counts as this SDK's only when the
  module's entrypoint does. A file above it within the module applies until a
  nearer one is written, so writing one must not drop what that file sets.
  """
  let checkConfig: Void {
    if (fileExists(entrypointPath + "/dang.toml")) {
      if (ownsEntrypoint == false) {
        raise configIn(entrypointPath) + " was not written by this SDK, and generating the entrypoint would replace it: move it, or remove it"
      }
      let config = parsedToml(contentsOf(entrypointPath + "/dang.toml"))
      let language = stringField(config, "dang")
      if (language != "" and language != "2.1") {
        raise configIn(entrypointPath) + " declares dang = " + language + ", and the generated entrypoint is written in Dang 2.1"
      }
      importNames(config).each { name =>
        let imported = config.field(["imports", name])
        let dagger = stringField(imported, "dagger")
        if (name == "Dagger" and stringField(imported, "path") != "") {
          raise configIn(entrypointPath) + " gives the Dagger import a path, and the generated entrypoint needs it to connect to the engine"
        }
        if (dagger != "" and dagger != targetEngineVersion and name != "Dagger") {
          raise configIn(entrypointPath) + " pins the import " + name + " to Dagger " + dagger + ", which disagrees with the generated entrypoint's " + targetEngineVersion
        }
        if (pathStaysInSdk(stringField(imported, "path"))) {
          raise configIn(entrypointPath) + " imports " + name + " from " + stringField(imported, "path") + " inside sdk/, which generation replaces: move it outside sdk/"
        }
        null
      }
      null
    } else {
      ["sdk/dang.toml", "dang.toml"].filter { path => fileExists(path) }.each { path =>
        if (isSubsumedConfig(parsedToml(contentsOf(path))) == false) {
          raise path + " in the module at " + rootPath + " applies to the entrypoint, and the dang.toml generated beside it would replace its settings: move them to " + entrypointPath + "/dang.toml"
        }
        null
      }
      null
    }
  }

  """
  Whether an import path of the entrypoint's dang.toml resolves inside sdk/.
  """
  let pathStaysInSdk(path: String!): Boolean! {
    let resolved = path.split("/").reduce(["sdk", "entrypoint"]) { segments, segment =>
      if (segment == "" or segment == ".") {
        segments
      } else if (segment == ".." and segments.length > 0 and (segments[segments.length - 1] ?? "") != "..") {
        segments.dropLast(1)
      } else {
        segments + [segment]
      }
    }
    path != "" and path.hasPrefix("/") == false and (resolved[0] ?? "") == "sdk"
  }

  """
  Whether a dang.toml sets nothing but what the generated one sets too.
  """
  let isSubsumedConfig(config: JSONValue!): Boolean! {
    let extra = config.fields.filter { field => field != "dang" and field != "imports" }
    let language = stringField(config, "dang")
    let imports = importNames(config).filter { name =>
      let imported = config.field(["imports", name])
      let dagger = stringField(imported, "dagger")
      name != "Dagger" or imported.fields.filter { field => field != "dagger" }.length > 0 or
        (dagger != "" and dagger != targetEngineVersion)
    }
    extra.length == 0 and (language == "" or language == "2.1") and imports.length == 0
  }

  let importNames(config: JSONValue!): [String!]! {
    if (config.fields.contains("imports")) { config.field(["imports"]).fields } else { [] }
  }

  let configIn(dir: String!): String! {
    dir + "/dang.toml in the module at " + rootPath
  }

  """
  sdk/ belongs to the SDK. A directory there that is not the SDK's library is the
  user's, and replacing it would lose it.
  """
  let checkSdkOwned: Void {
    if (fileExists("sdk") and ownsSdk == false) {
      raise "sdk/ in the " + label + " is not the SDK's library, and generating would replace it: move it"
    }
    null
  }

  """
  Whether sdk/ is the SDK's library, which generation may replace.
  """
  pub ownsSdk: Boolean! {
    if (fileExists("sdk/composer.json")) {
      stringField(parsedJson(contentsOf("sdk/composer.json")), "name") == "dagger/dagger"
    } else {
      false
    }
  }

  """
  Without the scope's clients, generation would drop their files. A client of
  this module is told by its path, so one bound by a Git ref, as a module of a
  workspace opened from Git is, passes. A client generates into a namespace
  named after its module in PascalCase, and PHP compares class names without
  case.
  """
  let checkClients: Void {
    if (clients == null and fileExists("sdk/generated/Clients")) {
      raise "module at " + rootPath + " has module clients, which only its scope in dagger.toml lists: run dagger generate"
    }
    knownClients.reduce([] :: [String!]!) { seen, client =>
      let name = client.moduleName
      if (clientAddress(client) == moduleRef) {
        raise label + " declares itself as the client " + name + ", which php-sdk does not generate: remove the client"
      }
      let taken = seen.filter { other => namespaceKey(other) == namespaceKey(name) }
      if (taken.length > 0) {
        raise label + " has the clients " + (taken[0] ?? "") + " and " + name + ", which generate into one PHP namespace: remove one"
      }
      seen + [name]
    }
    null
  }

  let knownClients: [ModuleSource!]! {
    clients ?? ([] :: [ModuleSource!]!)
  }

  let namespaceKey(name: String!): String! {
    name.replaceMatches("[^A-Za-z0-9]", "").toLower
  }

  """
  The address a client serves its module from. A module of the workspace is
  addressed from the root of the caller's tree, which serveModule reads a
  leading "/" from; a Git module by its ref, with the commit the engine
  resolved as its pin.
  """
  let clientAddress(client: ModuleSource!): String! {
    if (client.kind == ModuleSourceKind.GIT_SOURCE) { return client.asString }
    let subpath = client.sourceRootSubpath.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (subpath == "" or subpath == ".") { "/" } else { "/" + subpath }
  }

  """
  Why the generated entrypoint cannot run this module. The entrypoint builds from
  the module's own directory with the Composer settings the module has, so what
  reaches outside that directory, or changes what it loads, is not preserved.
  The engine reads pre-v2 clients and disableDefaultFunctionCaching only from a
  runtime manifest.
  """
  let entrypointBlockers: [String!]! {
    let declared = ["include", "exclude", "blueprint", "toolchains", "clients"]
      .filter { field => declares(field) }
      .map { field => "it declares " + field }
    let cachingDisabled = declares("disableDefaultFunctionCaching") and toString(manifest.field(["disableDefaultFunctionCaching"]).contents).trimSpace == "true"
    let cachingBlocker = if (cachingDisabled) { ["it sets disableDefaultFunctionCaching"] } else { [] :: [String!]! }
    let source = stringField(manifest, "source").trimPrefix("./").trimSuffix("/")
    let sourceBlocker = if (source == "" or source == ".") { [] :: [String!]! } else { ["its source is " + source] }
    declared + cachingBlocker + sourceBlocker + composerBlockers
  }

  let composerBlockers: [String!]! {
    if (fileExists("composer.json") == false) {
      [] :: [String!]!
    } else {
      let composer = parsedJson(contentsOf("composer.json"))
      let external = (repositoryPaths + autoloadPaths(composer, "autoload") + autoloadPaths(composer, "autoload-dev"))
        .filter { path => leavesModule(path) }
        .map { path => "Composer reads " + path + " outside the module" }
      let vendorDir = if (composer.fields.contains("config")) { stringField(composer.field(["config"]), "vendor-dir") } else { "" }
      (if (usesSdkRepository) { [] :: [String!]! } else { ["composer.json has no path repository ./sdk"] }) +
        external +
        (if (vendorDir == "" or vendorDir == "vendor") { [] :: [String!]! } else { ["composer.json moves vendor-dir to " + vendorDir] })
    }
  }

  let repositoryPaths: [String!]! {
    let composer = parsedJson(contentsOf("composer.json"))
    let repositories = if (composer.fields.contains("repositories")) { rawEntries(composer.field(["repositories"])) } else { [] :: [String!]! }
    repositories
      .filter { repository => stringField(parsedJson(repository), "type") == "path" }
      .map { repository => stringField(parsedJson(repository), "url") }
  }

  let usesSdkRepository: Boolean! {
    repositoryPaths.filter { path => path.trimPrefix("./").trimSuffix("/") == "sdk" }.length > 0
  }

  let autoloadPaths(composer: JSONValue!, section: String!): [String!]! {
    if (composer.fields.contains(section)) {
      let autoload = composer.field([section])
      autoload.fields.reduce([] :: [String!]!) { paths, kind =>
        let value = autoload.field([kind])
        let nested = if (kind == "psr-4" or kind == "psr-0") { rawEntries(value) } else { [toString(value.contents)] }
        paths + nested.reduce([] :: [String!]!) { found, item => found + stringsOf(item) }
      }
    } else {
      []
    }
  }

  let leavesModule(path: String!): Boolean! {
    let depth = path.split("/").reduce(0) { current, segment =>
      if (current < 0) {
        current
      } else if (segment == "..") {
        current - 1
      } else if (segment == "" or segment == ".") {
        current
      } else {
        current + 1
      }
    }
    path.hasPrefix("/") or path.hasPrefix("~") or path.contains("$") or depth < 0
  }

  """
  The elements of a JSON array or the values of an object, as JSON text.
  """
  let rawEntries(value: JSONValue!): [String!]! {
    if (toString(value.contents).trimSpace.hasPrefix("[")) {
      value.asArray.{{contents}}.map { item => toString(item.contents) }
    } else {
      value.fields.map { name => toString(value.field([name]).contents) }
    }
  }

  let stringsOf(raw: String!): [String!]! {
    let text = raw.trimSpace
    if (text.hasPrefix("\"")) {
      [parsedJson(text).asString]
    } else if (text.hasPrefix("[")) {
      rawEntries(parsedJson(text)).reduce([] :: [String!]!) { found, item => found + stringsOf(item) }
    } else {
      []
    }
  }

  let parsedJson(raw: String!): JSONValue! {
    json.withContents((raw :: Dagger.JSON!))
  }

  let stringField(value: JSONValue!, key: String!): String! {
    let fields = value.fields rescue {
      err: Error => [] :: [String!]!
    }
    if (fields.contains(key)) {
      value.field([key]).asString rescue {
        err: Error => ""
      }
    } else {
      ""
    }
  }

  """
  A manifest field that holds something: a null or an empty list says nothing.
  """
  let declares(field: String!): Boolean! {
    if (manifest.fields.contains(field)) {
      let raw = toString(manifest.field([field]).contents).trimSpace
      raw != "null" and raw != "[]" and raw != "{}" and raw != "\"\""
    } else {
      false
    }
  }

  let runtimeSource: String! {
    let key = if (manifest.fields.contains("runtime")) { "runtime" } else if (manifest.fields.contains("sdk")) { "sdk" } else { "" }
    if (key == "") {
      ""
    } else {
      let value = manifest.field([key])
      value.asString rescue {
        err: Error => stringField(value, "source")
      }
    }
  }

  let hasEntrypoint: Boolean! {
    manifest.fields.contains("entrypoint")
  }

  let manifest: JSONValue! {
    if (fileExists("dagger-module.toml")) {
      parsedToml(contentsOf("dagger-module.toml"))
    } else if (fileExists("dagger.json")) {
      parsedJson(contentsOf("dagger.json"))
    } else {
      parsedJson("{}")
    }
  }

  let parsedToml(contents: String!): JSONValue! {
    parsedJson(JSON.encode(TOML.decode(contents)))
  }

  let moduleName: String! {
    if (givenName != "") { givenName } else { stringField(manifest, "name") }
  }

  let moduleRef: String! {
    # rootPath is workspace-root-relative: Workspace.moduleSource resolves a
    # relative path from ws.cwd and would prefix it a second time.
    if (rootPath == ".") { "/" } else { "/" + rootPath }
  }

  let modulePath(path: String!): String! {
    if (rootPath == ".") { path } else { rootPath + "/" + path }
  }

  let fileExists(path: String!): Boolean! {
    let full = modulePath(path)
    ws.directory("/", include: [full]).exists(full)
  }

  let contentsOf(path: String!): String! {
    let full = modulePath(path)
    ws.directory("/", include: [full]).file(full).contents
  }

  """
  The engine's changes to this module. Its runtime path replaces sdk/, so a
  dang.toml of the entrypoint this module also names would go with it; it is
  kept for the day the module leaves the runtime.
  """
  let legacyChanges: Changeset! {
    let changes = ws.moduleSource(moduleRef).generatedContextChangeset
    if (ownsEntrypoint and fileExists(entrypointPath + "/dang.toml")) {
      let rooted = ws.withWorkdir(".")
      atCwd(
        rooted
          .withChanges(changes)
          .withNewFile(modulePath(entrypointPath + "/dang.toml"), contentsOf(entrypointPath + "/dang.toml"), permissions: 420)
          .changes(rooted),
      )
    } else {
      atCwd(changes)
    }
  }

  """
  Re-root a workspace-rooted changeset at the client's cwd.

  The engine roots a generated context at the workspace, but a returned
  changeset is applied relative to the caller's cwd, so without this every path
  lands nested under the cwd a second time. `ModuleSource.generate` followed by
  `Workspace.changes(from:)` is the native API for this, but that pair reports
  a module's whole generated context as added rather than only what generation
  changed — including engine-owned files the SDK must not touch — so the
  rooting stays explicit here. Tracked by
  https://github.com/dagger/dagger/issues/13947
  """
  let atCwd(changes: Changeset!): Changeset! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (cwd == "" or cwd == ".") {
      changes
    } else {
      # A cwd-relative changeset cannot express paths outside the cwd — e.g. a
      # module discovered above it — and re-rooting would silently drop them,
      # leaving that module never regenerated. Fail loudly instead.
      let outside = (changes.addedPaths + changes.modifiedPaths + changes.removedPaths)
        .filter { path => path != cwd and path.hasPrefix(cwd + "/") == false }
      if (outside.length > 0) {
        raise "generated changes fall outside the current directory " + cwd + ": " + outside.join(", ")
      }
      changes.after.directory(cwd).changes(changes.before.directory(cwd))
    }
  }
}
