"""
Manage Dagger modules that use the PHP SDK.
"""
type PhpSdk {
  # Matches `"sdk": { "source": "php" }` in a legacy dagger.json.
  let legacyConfigPattern = "\"sdk\"\\s*:\\s*\\{[^}]*\"source\"\\s*:\\s*\"php\""

  # Matches a `[runtime]` table with `source = "php"` in a CLI 1.0
  # dagger-module.toml.
  let tomlConfigPattern = "\\[runtime\\][^\\[]*source\\s*=\\s*\"php\""

  let moduleConfigFilenames: [String!]! = ["dagger-module.toml", "dagger.json"]

  """
  Marker filename that skips generate when found at or above a PHP SDK module root.
  """
  pub skipGenerateFilename: String! = ".dagger-php-sdk-skip-generate"

  """
  Starter template under templates/<template> for a new module.
  """
  pub template: String! = "minimal"

  """
  Refuse an engine below the floor. The e2e module turns this off to find the
  floor, which needs a public setting because it is another module. An engine
  below the floor is not supported.
  """
  pub enforceEngineFloor: Boolean! = true

  """
  Find the PHP client root containing the workspace cwd: the directory of the
  nearest composer.json, relative to the workspace root. A module's vendored
  SDK carries its own composer.json under sdk/, so the module owning it answers
  instead. Null when there is none.
  """
  pub findClientRoot(ws: Workspace!): String {
    let found = ws.findUp("composer.json")
    if (found == null) {
      null
    } else {
      let root = normalizePath(found.trimSuffix("composer.json"))
      let vendorParent = if (root == "sdk") { "." } else { root.trimSuffix("/sdk") }
      if (vendorParent != root and hasModuleConfig(ws, vendorParent)) {
        vendorParent
      } else {
        root
      }
    }
  }

  """
  Generate one SDK scope: the module at the workspace cwd, when the scope is a
  module. A scope without a module config is first seeded from the `template`
  setting, keeping the files already there, and given a dagger-module.toml. A
  self-contained module then moves to the entrypoint this SDK generates; see
  Mod.usesEntrypoint. Module clients are not generated yet.
  """
  pub generateScope(ws: Workspace!, isModule: Boolean!, name: String!, clients: [ModuleSource!]!): Workspace! {
    checkEngine
    if (clients.length > 0) {
      raise "php-sdk does not generate module clients yet"
    }

    if (isModule == false) {
      ws
    } else {
      let scope = normalizePath(ws.cwd)
      # Mod.rootPath is workspace-root-relative, so the scope is generated from
      # the root and the cwd restored afterwards: the engine rejects a result
      # whose cwd is not the scope.
      let rooted = ws.withWorkdir(".")
      let selectedTemplate = if (template == "") { "minimal" } else { template }
      let initialized = if (hasModuleConfig(ws, scope)) {
        rooted
      } else if (currentModule.source.exists("templates/" + selectedTemplate) == false) {
        raise "unknown init template: " + template
      } else {
        sdkHelpers.moduleManifest
          .withName(name: name)
          .withLegacyRuntime(runtime: "php", engineVersion: targetEngineVersion)
          .generate(
            rooted.withDirectory(scope, renderedTemplate(name, selectedTemplate)).withWorkdir(scope),
            legacyJson: false,
          )
          .withWorkdir(".")
      }
      modAt(scope, initialized, name).generated.withWorkdir(scope)
    }
  }

  """
  The engine API version a new module declares. It stays before the
  identifier-casing cut, whose release is not decided and which renames core API
  fields and changes module naming, until the PHP codegen is ported to those
  rules: declaring the running engine would put new modules past that cut as soon
  as engines reach it. Every v1.0.0 prerelease up to beta.21 shares one API view,
  and released engines compare base versions, so older engines load it alike. The
  module's client schema, its DAGGER_CLIENT_VERSION and its dang.toml use this one
  value.
  """
  let targetEngineVersion: String! = "v1.0.0-beta.21"

  """
  The oldest release the generated entrypoint passes on, by the e2e module's
  entrypoint-floor-check.
  """
  let floorEngineVersion: String! = "v1.0.0-beta.17"

  """
  Whether the running engine is below the floor. Released engines compare base
  versions, so the manifest's engineVersion does not keep an older v1.0.0
  prerelease out. A dev build or a later release is not below it.
  """
  pub belowEngineFloor: Boolean! {
    let prefix = "v1.0.0-beta."
    let release = version.split("+")[0] ?? version
    let beta = release.trimPrefix(prefix)
    let floor = floorEngineVersion.trimPrefix(prefix)
    release.hasPrefix("v0.") or release.hasPrefix("v1.0.0-0") or
      (beta != release and beta.containsMatch("^[0-9]+$") and beta.padLeft(6) < floor.padLeft(6))
  }

  let checkEngine: Void {
    if (enforceEngineFloor and belowEngineFloor) {
      raise "php-sdk needs an engine from " + floorEngineVersion + ", and this one is " + version + ": upgrade the engine"
    }
    null
  }

  let modAt(path: String!, ws: Workspace!, name: String!): Mod! {
    Mod(
      rootPath: path,
      ws: ws,
      skipGenerateFilename: skipGenerateFilename,
      targetEngineVersion: targetEngineVersion,
      givenName: name,
    )
  }

  """
  Whether a module config exists in a workspace-root-relative directory.
  """
  let hasModuleConfig(ws: Workspace!, dir: String!): Boolean! {
    moduleConfigFilenames.filter { filename =>
      let path = if (dir == ".") { filename } else { dir + "/" + filename }
      ws.directory("/", include: [path]).exists(path)
    }.length > 0
  }

  let normalizePath(path: String!): String! {
    let normalized = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (normalized == "") { "." } else { normalized }
  }

  """
  Return init templates tracked by this module.

  Templates live under templates/<name> and are materialized into a new module
  before generation. The `template` setting selects one; empty selects the
  default.
  """
  pub templates: [Template!]! {
    if (currentModule.source.exists("templates")) {
      let root = currentModule.source.directory("templates")
      root.entries.map { name =>
        Template(
          name: name.trimSuffix("/"),
          source: root.directory(name),
        )
      }
    } else {
      directory.entries.map { name =>
        Template(
          name: name,
          source: directory,
        )
      }
    }
  }

  """
  Return the PHP SDK module at or above a workspace path.

  When `findUp` is true, `path` may point inside the module.
  """
  pub mod(ws: Workspace!, path: String! = ".", findUp: Boolean! = true): Mod! {
    checkEngine
    let modPath = if (findUp) {
      # Pick the nearest enclosing config regardless of filename ordering.
      let foundConfigPath = moduleConfigFilenames.reduce(null) { nearest, filename =>
        let found = ws.findUp(filename, path)
        if (configHitDepth(found) > configHitDepth(nearest)) { found } else { nearest }
      }
      if (foundConfigPath == null) {
        raise "no Dagger module found containing path: " + path
      } else {
        let configPath = foundConfigPath.trimPrefix("/")
        if (isPhpConfig(ws, configPath) == false) {
          raise "Dagger module does not use the PHP SDK: " + path
        } else {
          let dir = configPath.split("/").dropLast(1).join("/")
          if (dir == "") { "." } else { dir }
        }
      }
    } else {
      normalizePath(path)
    }

    modAt(modPath, ws, "")
  }

  """
  Return the depth of the directory containing a find-up result.
  """
  let configHitDepth(hit: String): Int! {
    if (hit == null) {
      -1
    } else {
      let dir = hit.split("/").dropLast(1).join("/").trimPrefix("/")
      if (dir == "") { 0 } else { dir.split("/").length }
    }
  }

  """
  Whether a module config selects the PHP runtime or the entrypoint this SDK
  generates.
  """
  let isPhpConfig(ws: Workspace!, configPath: String!): Boolean! {
    let dir = configPath.split("/").dropLast(1).join("/")
    selectsPhpRuntime(ws, configPath) or modAt(if (dir == "") { "." } else { dir }, ws, "").ownsEntrypoint
  }

  let selectsPhpRuntime(ws: Workspace!, configPath: String!): Boolean! {
    let pattern = if (configPath.trimSuffix("dagger-module.toml") != configPath) {
      tomlConfigPattern
    } else {
      legacyConfigPattern
    }
    ws
      .directory("/", include: [configPath])
      .file(configPath)
      .search(
        pattern: pattern,
        multiline: true,
        dotall: true,
        limit: 1,
      )
      .{{id}}
      .length > 0
  }

  """
  Render a PHP template with the requested module name.
  """
  let renderedTemplate(name: String!, templateName: String!): Directory! {
    container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helper", currentModule.source.directory("helpers/render-template"))
      .withDirectory("/template", currentModule.source.directory("templates/" + templateName))
      .withWorkdir("/helper")
      .withExec(["go", "build", "-o", "/usr/local/bin/render-template", "."])
      .withExec(["render-template", name, "/template", "/rendered"])
      .directory("/rendered")
  }
}
