"""
Manage Dagger modules that use the PHP SDK.
"""
type PhpSdk {
  # Matches `"sdk": { "source": "php" }` in a legacy dagger.json.
  let legacyConfigPattern = "\"sdk\"\\s*:\\s*\\{[^}]*\"source\"\\s*:\\s*\"php\""

  # Matches a `[runtime]` table with `source = "php"` in a CLI 1.0
  # dagger-module.toml.
  let tomlConfigPattern = "\\[runtime\\][^\\[]*source\\s*=\\s*\"php\""

  let moduleConfigFilenames: [String!]! = ["dagger-module.toml", "dagger.json"]

  """
  Marker filename that skips generate when found at or above a PHP SDK module root.
  """
  pub skipGenerateFilename: String! = ".dagger-php-sdk-skip-generate"

  """
  Starter template under templates/<template> for a module without composer.json.
  """
  pub template: String! = "minimal"

  """
  The engine release a module's generated code targets: the floor or later, and
  the release this SDK generates for or earlier. Empty takes the release this SDK
  generates for.
  """
  pub targetVersion: String! = ""

  """
  Find the PHP client root containing the workspace cwd: the directory of the
  nearest composer.json, relative to the workspace root. A module's vendored
  SDK carries its own composer.json under sdk/, so the module owning it answers
  instead. Null when there is none.
  """
  pub findClientRoot(ws: Workspace!): String {
    let found = ws.findUp("composer.json")
    if (found == null) {
      null
    } else {
      let root = normalizePath(found.trimSuffix("composer.json"))
      let vendorParent = if (root == "sdk") { "." } else { root.trimSuffix("/sdk") }
      if (vendorParent != root and hasModuleConfig(ws, vendorParent)) {
        vendorParent
      } else {
        root
      }
    }
  }

  """
  Generate one SDK scope: the module at the workspace cwd, when the scope is a
  module. A scope without a module config is given a dagger-module.toml. A
  self-contained module then moves to the entrypoint this SDK generates, seeded
  from the `template` setting when it has no composer.json; see
  Mod.usesEntrypoint. The module's clients are generated into its sdk/; a scope
  without a module cannot have clients yet.
  """
  pub generateScope(ws: Workspace!, isModule: Boolean!, name: String!, clients: [ModuleSource!]!): Workspace! {
    checkEngine
    if (isModule == false) {
      if (clients.length > 0) {
        raise "php-sdk does not generate module clients in a scope without a module yet: remove the clients " + clientNames(clients)
      }
      ws
    } else {
      let scope = normalizePath(ws.cwd)
      # Mod.rootPath is workspace-root-relative, so the scope is generated from
      # the root and the cwd restored afterwards: the engine rejects a result
      # whose cwd is not the scope.
      let rooted = ws.withWorkdir(".")
      let target = targetRelease("module \"" + name + "\"")
      let initialized = if (hasModuleConfig(ws, scope)) {
        rooted
      } else {
        sdkHelpers.moduleManifest
          .withName(name: name)
          .withLegacyRuntime(runtime: "php", engineVersion: target)
          .generate(rooted.withWorkdir(scope), legacyJson: false)
          .withWorkdir(".")
      }
      targetedMod(scope, initialized, name, "module \"" + name + "\"", clients: clients).generated.withWorkdir(scope)
    }
  }

  """
  The engine API version a new module declares, past the identifier-casing cut at
  v1.0.0-beta.26. Released engines compare base versions, so older engines load
  it. The module's client schema, its DAGGER_CLIENT_VERSION and its dang.toml use
  this one value.
  """
  let targetEngineVersion: String! = "v1.0.0-beta.27"

  """
  The template the `template` setting names, `minimal` when it is empty.
  """
  let selectedTemplate: String! {
    if (template == "") { "minimal" } else { template }
  }

  """
  The oldest release the generated entrypoint passed on, for modules targeting
  v1.0.0-beta.21. It has not run again with the current target.
  """
  let floorEngineVersion: String! = "v1.0.0-beta.17"

  """
  Whether the running engine is below the floor. Released engines compare base
  versions, so the manifest's engineVersion does not keep an older v1.0.0
  prerelease out. A dev build or a later release is not below it.
  """
  let belowEngineFloor: Boolean! {
    let prefix = "v1.0.0-beta."
    let release = version.split("+")[0] ?? version
    let beta = release.trimPrefix(prefix)
    let floor = floorEngineVersion.trimPrefix(prefix)
    release.hasPrefix("v0.") or release.hasPrefix("v1.0.0-0") or
      (beta != release and beta.containsMatch("^[0-9]+$") and beta.padLeft(6) < floor.padLeft(6))
  }

  let checkEngine: Void {
    if (belowEngineFloor) {
      raise "php-sdk needs an engine from " + floorEngineVersion + ", and this one is " + version + ": upgrade the engine"
    }
    null
  }

  let modAt(path: String!, ws: Workspace!, name: String!, target: String! = targetEngineVersion, laterEngine: Boolean! = false, clients: [ModuleSource!] = null): Mod! {
    Mod(
      rootPath: path,
      ws: ws,
      skipGenerateFilename: skipGenerateFilename,
      targetEngineVersion: target,
      givenName: name,
      templateName: selectedTemplate,
      declaresLaterEngine: laterEngine,
      clients: clients,
    )
  }

  """
  Whether the module config in a workspace-root-relative directory declares an
  engineVersion later than targetEngineVersion, the latest release this SDK can
  generate for. A pinned targetVersion does not change the comparison. Mod reads
  its own manifest, but only PhpSdk can compare releases.
  """
  let declaresLaterEngine(ws: Workspace!, dir: String!): Boolean! {
    let path = moduleConfigPath(ws, dir)
    if (path == "") { return false }
    let contents = ws.directory("/", include: [path]).file(path).contents
    let raw = if (path.hasSuffix(".toml")) { JSON.encode(TOML.decode(contents)) } else { contents }
    let declared = json.withContents((raw :: Dagger.JSON!)).field(["engineVersion"]).asString rescue {
      err: Error => ""
    }
    releasePrecedes(targetEngineVersion, declared)
  }

  """
  The module at path, generating for the release a targetVersion setting names.
  A pin or a client on a module that keeps the PHP runtime is refused: the engine
  regenerates that module for its manifest's engineVersion, without clients. A
  client module that declares a release on the other side of the identifier-casing
  cut at v1.0.0-beta.26 from that release is refused too. The engine names a client
  module by the rules of the release it declares. Its client is generated in the
  view of the release this module generates for.
  """
  let targetedMod(path: String!, ws: Workspace!, name: String!, subject: String!, setting: String! = targetVersion, clients: [ModuleSource!] = null): Mod! {
    let target = targetRelease(subject, setting)
    let mod = modAt(path, ws, name, target, declaresLaterEngine(ws, path), clients)
    let given = clients ?? ([] :: [ModuleSource!]!)
    if (setting != "" and mod.skipGenerate == false and mod.usesEntrypoint == false) {
      raise subject + " pins targetVersion " + target + ", which applies to the generated entrypoint only: this module keeps the PHP runtime, which generates for the engineVersion of its manifest. Remove targetVersion from the scope's settings in dagger.toml"
    }
    if (given.length > 0 and mod.skipGenerate == false and mod.usesEntrypoint == false) {
      raise subject + " keeps the PHP runtime, whose sdk/ the engine generates without clients: move the module to the generated entrypoint, or remove the clients " + clientNames(given)
    }
    given.each { client =>
      let cut = "v1.0.0-beta.26"
      let declared = client.engineVersion
      if (declared.containsMatch(Regexp(releasePattern)) and releasePrecedes(declared, cut) != releasePrecedes(target, cut)) {
        raise subject + " generates for " + target + " and has the client " + client.moduleName + ", which declares " + declared + ", across the identifier-casing cut at " + cut + ": the engine names the client module by the rules of " + declared + ", and its client would use the names of " + target + ". Have the client module declare a release on the same side of the cut as " + target + ", or remove the client"
      }
      null
    }
    mod
  }

  let clientNames(clients: [ModuleSource!]!): String! {
    clients.map { client => client.moduleName }.join(", ")
  }

  """
  The release a module generates for. A targetVersion this SDK cannot generate for
  is refused before anything is written.
  """
  let targetRelease(subject: String!, setting: String! = targetVersion): String! {
    if (setting == "") { return targetEngineVersion }
    let fix = "Set targetVersion between " + floorEngineVersion + " and " + targetEngineVersion + " in the scope's settings in dagger.toml, or remove it"
    if (setting.containsMatch(Regexp(releasePattern)) == false) {
      raise subject + " pins targetVersion " + JSON.encode(setting) + ", which is not a Dagger release such as " + targetEngineVersion + ". " + fix
    }
    let bare = setting.split("+")[0] ?? setting
    let target = if (bare.hasPrefix("v")) { bare } else { "v" + bare }
    if (releasePrecedes(target, floorEngineVersion)) {
      raise subject + " pins targetVersion " + target + ", which this release of the PHP SDK cannot generate for: it is below " + floorEngineVersion + ", the oldest engine this SDK runs on. " + fix
    }
    if (releasePrecedes(targetEngineVersion, target)) {
      raise subject + " pins targetVersion " + target + ", which this release of the PHP SDK cannot generate for: it targets " + targetEngineVersion + " at most. " + fix + ", or install the SDK release built for " + target
    }
    target
  }

  """v?MAJOR.MINOR.PATCH, then an optional prerelease and build, as in the Go SDK."""
  let releasePattern: String! = "^v?([0-9]+)\\.([0-9]+)\\.([0-9]+)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"

  """Semver precedence; false when either is not a release, so an unreadable version passes."""
  let releasePrecedes(a: String!, b: String!): Boolean! {
    let pattern = Regexp(releasePattern)
    let ma = a.match(pattern)
    if (ma == null) { return false }
    let mb = b.match(pattern)
    if (mb == null) { return false }
    let ca = ma.captures
    let cb = mb.captures
    let coreA = [ca[0] ?? "", ca[1] ?? "", ca[2] ?? ""]
    let coreB = [cb[0] ?? "", cb[1] ?? "", cb[2] ?? ""]
    if (identifiersPrecede(coreA, coreB, 0)) { return true }
    if (identifiersPrecede(coreB, coreA, 0)) { return false }
    let preA = ca[3] ?? ""
    let preB = cb[3] ?? ""
    if (preA == "") {
      false
    } else if (preB == "") {
      true
    } else {
      identifiersPrecede(preA.split("."), preB.split("."), 0)
    }
  }

  """Numbers by value before words, words by ASCII, a prefix first."""
  let identifiersPrecede(a: [String!]!, b: [String!]!, i: Int!): Boolean! {
    if (i >= a.length) { return i < b.length }
    if (i >= b.length) { return false }
    let x = a[i] ?? ""
    let y = b[i] ?? ""
    if (x == y) { return identifiersPrecede(a, b, i + 1) }
    let xNumber = x.containsMatch(Regexp("^[0-9]+$"))
    let yNumber = y.containsMatch(Regexp("^[0-9]+$"))
    if (xNumber and yNumber) {
      let xDigits = x.split("").length
      let yDigits = y.split("").length
      if (xDigits == yDigits) { x < y } else { xDigits < yDigits }
    } else {
      xNumber or (yNumber == false and x < y)
    }
  }

  """
  Whether a module config exists in a workspace-root-relative directory.
  """
  let hasModuleConfig(ws: Workspace!, dir: String!): Boolean! {
    moduleConfigPath(ws, dir) != ""
  }

  """
  The module config in a workspace-root-relative directory, dagger-module.toml
  first, or an empty string when there is none.
  """
  let moduleConfigPath(ws: Workspace!, dir: String!): String! {
    let paths = moduleConfigFilenames
      .map { filename => if (dir == ".") { filename } else { dir + "/" + filename } }
      .filter { path => ws.directory("/", include: [path]).exists(path) }
    paths[0] ?? ""
  }

  let normalizePath(path: String!): String! {
    let normalized = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (normalized == "") { "." } else { normalized }
  }

  """
  Return init templates tracked by this module.

  Templates live under templates/<name> and are materialized into a new module
  before generation. The `template` setting selects one; empty selects the
  default.
  """
  pub templates: [Template!]! {
    if (currentModule.source.exists("templates")) {
      let root = currentModule.source.directory("templates")
      root.entries.map { name =>
        Template(
          name: name.trimSuffix("/"),
          source: root.directory(name),
        )
      }
    } else {
      directory.entries.map { name =>
        Template(
          name: name,
          source: directory,
        )
      }
    }
  }

  """
  Return the PHP SDK module at or above a workspace path.

  When `findUp` is true, `path` may point inside the module.
  """
  pub mod(ws: Workspace!, path: String! = ".", findUp: Boolean! = true): Mod! {
    checkEngine
    let modPath = if (findUp) {
      # Pick the nearest enclosing config regardless of filename ordering.
      let foundConfigPath = moduleConfigFilenames.reduce(null) { nearest, filename =>
        let found = ws.findUp(filename, path)
        if (configHitDepth(found) > configHitDepth(nearest)) { found } else { nearest }
      }
      if (foundConfigPath == null) {
        raise "no Dagger module found containing path: " + path
      } else {
        let configPath = foundConfigPath.trimPrefix("/")
        if (isPhpConfig(ws, configPath) == false) {
          raise "Dagger module does not use the PHP SDK: " + path
        } else {
          let dir = configPath.split("/").dropLast(1).join("/")
          if (dir == "") { "." } else { dir }
        }
      }
    } else {
      normalizePath(path)
    }

    let setting = if (targetVersion == "") { recordedTargetVersion(ws, modPath) } else { targetVersion }
    targetedMod(modPath, ws, "", "module at " + modPath, setting)
  }

  """
  The targetVersion the workspace config records for the scope at a
  workspace-root-relative path, or empty. The engine passes a scope's settings
  only when it generates the scope itself, so a direct mod reads them from the
  config file, not its includes, as the engine does. WorkspaceSDK.scopeSetting
  answers this only in views from v1.0.0-beta.26, and this module's
  engineVersion is v1.0.0-beta.17. Unlike python-sdk, a targetVersion passed to
  the SDK wins over the record. Only targetVersion is checked for conflicting or
  case-colliding records; the engine validates the rest of the config. Follows
  dagger/dagger v1.0.0-beta.27 core/workspace.
  """
  let recordedTargetVersion(ws: Workspace!, scope: String!): String! {
    let rooted = ws.withWorkdir(".")
    let configFile = rooted.configFile
    if (configFile == "") { return "" }
    let config = json.withContents((JSON.encode(TOML.decode(rooted.file("/" + configFile).contents)) :: Dagger.JSON!))
    if (config.fields.contains("sdks") == false) { return "" }
    let sdks = config.field(["sdks"])
    let own = currentModule.name
    let names = sdks.fields.filter { name =>
      let sdk = sdks.field([name])
      name == own or (sdk.fields.contains("module") and sdk.field(["module"]).asString == own)
    }
    if (names.length > 1) {
      raise "SDK lookup name \"" + own + "\" is ambiguous: SDKs \"" + (names[0] ?? "") + "\" and \"" + (names[1] ?? "") + "\" both resolve it"
    }
    let sdkName = names[0] ?? ""
    if (sdkName == "" or sdks.field([sdkName]).fields.contains("scopes") == false) { return "" }
    let scopes = sdks.field([sdkName, "scopes"])
    let configDir = if (configFile.contains("/")) { configFile.split("/").dropLast(1).join("/") } else { "." }
    let target = scopeKeyPath(".", "/" + scope)
    let recorded = scopes.fields
      .filter { key => scopeKeyPath(configDir, key) == target and scopes.field([key]).fields.contains("settings") }
      .reduce([] :: [String!]!) { found, key =>
        let settings = scopes.field([key, "settings"])
        found + settings.fields.filter { name => name.toLower == "targetversion" }.map { name => name + " = " + settings.field([name]).asString }
      }
    if (recorded.filter { pin => pin != (recorded[0] ?? "") }.length > 0) {
      raise "SDK \"" + sdkName + "\" records several targetVersion settings for the scope " + target + ": " + recorded.join(", ") + "; keep one in dagger.toml"
    }
    (recorded[0] ?? "").split(" = ").dropFirst(1).join(" = ")
  }

  """
  The workspace-root-relative path a scope key names: a key with a leading "/"
  is rooted at the workspace root, any other is relative to the config's
  directory, and a key that escapes the root is refused.
  """
  let scopeKeyPath(configDir: String!, key: String!): String! {
    let slashed = key.replace("\\", "/")
    let rooted = slashed.hasPrefix("/")
    let joined = if (rooted) { slashed } else { configDir + "/" + slashed }
    let segments = joined.split("/").reduce([] :: [String!]!) { kept, segment =>
      if (segment == "" or segment == ".") {
        kept
      } else if (segment != "..") {
        kept + [segment]
      } else if (kept.length > 0 and (kept[kept.length - 1] ?? "") != "..") {
        kept.dropLast(1)
      } else if (rooted) {
        kept
      } else {
        kept + [segment]
      }
    }
    if ((segments[0] ?? "") == "..") {
      raise "the scope key " + JSON.encode(key) + " in dagger.toml escapes the workspace root"
    }
    if (segments.length == 0) { "." } else { segments.join("/") }
  }

  """
  Return the depth of the directory containing a find-up result.
  """
  let configHitDepth(hit: String): Int! {
    if (hit == null) {
      -1
    } else {
      let dir = hit.split("/").dropLast(1).join("/").trimPrefix("/")
      if (dir == "") { 0 } else { dir.split("/").length }
    }
  }

  """
  Whether a module config selects the PHP runtime or the entrypoint this SDK
  generates.
  """
  let isPhpConfig(ws: Workspace!, configPath: String!): Boolean! {
    let dir = configPath.split("/").dropLast(1).join("/")
    selectsPhpRuntime(ws, configPath) or modAt(if (dir == "") { "." } else { dir }, ws, "").ownsEntrypoint
  }

  let selectsPhpRuntime(ws: Workspace!, configPath: String!): Boolean! {
    let pattern = if (configPath.trimSuffix("dagger-module.toml") != configPath) {
      tomlConfigPattern
    } else {
      legacyConfigPattern
    }
    ws
      .directory("/", include: [configPath])
      .file(configPath)
      .search(
        pattern: pattern,
        multiline: true,
        dotall: true,
        limit: 1,
      )
      .{{id}}
      .length > 0
  }
}
