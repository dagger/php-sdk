"""
End-to-end checks for the PHP SDK helper module.
"""
type E2e {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let lookupModulePath: String! = fixtureRoot + "/lookup/app"
  let lookupNestedPath: String! = lookupModulePath + "/nested"
  let tomlModulePath: String! = fixtureRoot + "/toml/app"
  let clientRootModulePath: String! = fixtureRoot + "/client-root/app"
  let layeringModulePath: String! = fixtureRoot + "/layering/app"
  let rootingModulePath: String! = fixtureRoot + "/rooting/app"
  let entrypointModulePath: String! = fixtureRoot + "/entrypoint/app"
  let entrypointName: String! = "entrypoint-app"
  let outsideModulePath: String! = fixtureRoot + "/outside/app"
  let clientTargetPath: String! = fixtureRoot + "/client-target/app"
  let clientMakerPath: String! = fixtureRoot + "/client-target/maker"
  let clientCallerPath: String! = fixtureRoot + "/client-target/caller"
  let programPath: String! = fixtureRoot + "/client-target/program"
  let interfacesPath: String! = fixtureRoot + "/interfaces"
  let target: String! = "v1.0.0-beta.27"
  let entrypointConfigPath: String! = entrypointModulePath + "/sdk/entrypoint/dang.toml"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) { raise message }
    null
  }

  let contains(values: [String!]!, want: String!): Boolean! {
    values.filter { value => value == want }.length > 0
  }

  let cwdOf(ws: Workspace!): String! {
    ws.cwd.trimPrefix("/").trimSuffix("/")
  }

  let assertContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want), message + ": " + value)
  }

  let assertNotContains(value: String!, unwanted: String!, message: String!): Void {
    assert(value.contains(unwanted) == false, message + ": " + value)
  }

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory("/", include: [path]).exists(path)
  }

  let contentsOf(ws: Workspace!, path: String!): String! {
    ws.directory("/", include: [path]).file(path).contents
  }

  """
  The fixture module generated from a workspace, at the workspace root.
  """
  let generatedEntrypoint(ws: Workspace!, sdk: PhpSdk! = phpSdk, clients: [ModuleSource!]! = [], path: String! = entrypointModulePath, name: String! = entrypointName): Workspace! {
    sdk.generateScope(ws.withWorkdir(path), isModule: true, name: name, clients: clients).withWorkdir(".")
  }

  """
  The fixture program, a scope without a module, generated from a workspace, at
  the workspace root.
  """
  let generatedProgram(ws: Workspace!, clients: [ModuleSource!]!): Workspace! {
    phpSdk.generateScope(ws.withWorkdir(programPath), isModule: false, name: "", clients: clients).withWorkdir(".")
  }

  let usesEntrypoint(ws: Workspace!): Boolean! {
    phpSdk.mod(ws, path: entrypointModulePath, findUp: false).usesEntrypoint
  }

  """
  The message a direct generation of the module at path fails with, or the
  workspace cwd when it does not fail.
  """
  let directError(ws: Workspace!, path: String! = entrypointModulePath): String! {
    phpSdk.mod(ws, path: path, findUp: false).generated.cwd rescue {
      err: Error => err.message
    }
  }

  """
  Assert that a direct generation refuses the module at path as a module on the
  PHP runtime that cannot move to the entrypoint, for reason.
  """
  let assertMoveRefused(ws: Workspace!, what: String!, reason: String!, path: String! = entrypointModulePath): Void {
    let message = directError(ws, path)
    assertContains(message, "cannot move to the generated entrypoint", what + " should be refused")
    assertContains(message, reason, what + " was refused for the wrong reason")
  }

  let installsFromComposerFiles(ws: Workspace!): Boolean! {
    contentsOf(generatedEntrypoint(ws), entrypointModulePath + "/sdk/entrypoint/build.dang").contains("\"--no-autoloader\"")
  }

  """
  The message generation fails with, or an empty string when it does not fail.
  """
  let generationError(ws: Workspace!, sdk: PhpSdk! = phpSdk, clients: [ModuleSource!]! = [], path: String! = entrypointModulePath, name: String! = entrypointName): String! {
    let cwd = generatedEntrypoint(ws, sdk, clients, path, name).cwd rescue {
      err: Error => "failed: " + err.message
    }
    if (cwd.hasPrefix("failed: ")) { cwd.trimPrefix("failed: ") } else { "" }
  }

  let assertRefused(ws: Workspace!, want: String!, what: String!): Void {
    let message = generationError(ws)
    assert(message != "", what + " should be refused")
    assertContains(message, want, what + " was refused for the wrong reason")
  }

  let assertNoChange(ws: Workspace!, what: String!): Void {
    assert(generatedEntrypoint(ws).changes(ws).isEmpty, what + " changed on generation")
  }

  let withConfig(ws: Workspace!, contents: String!): Workspace! {
    ws.withNewFile("/" + entrypointConfigPath, contents)
  }

  """
  Lookup supports both config formats and chooses the nearest config regardless
  of filename ordering.
  """
  pub moduleLookupCheck(ws: Workspace!): Void @check {
    let nested = phpSdk.mod(ws, path: lookupNestedPath)
    let exact = phpSdk.mod(ws, path: lookupModulePath, findUp: false)
    let toml = phpSdk.mod(ws, path: tomlModulePath + "/nested")

    assert(nested.rootPath == lookupModulePath, "find-up returned the wrong legacy module")
    assert(exact.rootPath == lookupModulePath, "exact lookup returned the wrong module")
    assert(toml.rootPath == tomlModulePath, "a farther dagger.json shadowed the nearer dagger-module.toml")
    null
  }

  """
  The client root is the nearest composer.json, except that the vendored SDK of
  a module or a PHP program resolves to the module or program that owns it.
  """
  pub findClientRootCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    let fromModule = phpSdk.findClientRoot(root.asWorkspace(cwd: clientRootModulePath))
    let fromSdk = phpSdk.findClientRoot(root.asWorkspace(cwd: clientRootModulePath + "/sdk"))
    let outside = phpSdk.findClientRoot(root.asWorkspace(cwd: fixtureRoot))
    let program = root.withNewFile(programPath + "/sdk/composer.json", "{\"name\": \"dagger/dagger\"}\n")
    let fromProgramSdk = phpSdk.findClientRoot(program.asWorkspace(cwd: programPath + "/sdk"))

    assert(fromModule == clientRootModulePath, "a module should be its own client root")
    assert(fromSdk == clientRootModulePath, "a vendored SDK should resolve to the module that owns it")
    assert(fromProgramSdk == programPath, "a PHP program's vendored SDK should resolve to the program that owns it")
    assert(outside == null, "a directory outside any PHP project should have no client root")
    null
  }

  """
  generateScope seeds a new module into a directory that already holds files:
  the template and the manifest are added, nothing is removed, and the scope
  stays the cwd.
  """
  pub generateNewModuleCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    let generated = phpSdk.generateScope(
      root.asWorkspace(cwd: layeringModulePath),
      isModule: true,
      name: "layering",
      clients: [],
    )
    let changes = generated.directory("/").changes(root)

    assert(cwdOf(generated) == layeringModulePath, "generateScope changed the workspace cwd")
    assert(changes.removedPaths.length == 0, "generateScope removed files that already existed in the scope")
    assert(
      contains(changes.addedPaths, layeringModulePath + "/composer.json"),
      "generateScope did not seed the template into the scope",
    )
    assert(
      contains(changes.addedPaths, layeringModulePath + "/dagger-module.toml"),
      "generateScope did not write the module manifest",
    )
    assert(
      contains(changes.addedPaths, layeringModulePath + "/dagger.json") == false,
      "generateScope added a dagger.json to a new module",
    )
    let manifest = generated.file("dagger-module.toml").contents
    assertContains(manifest, "source = \"./sdk/entrypoint\"", "a new module should run on the generated entrypoint")
    assertNotContains(manifest, "[runtime]", "a new module should not keep the php runtime")
    assertContains(
      generated.file("sdk/entrypoint/dang.toml").contents,
      "dagger = \"v1.0.0-beta.27\"",
      "the entrypoint should declare v1.0.0-beta.27, past the identifier-casing cut",
    )
    let portedNaming = generated.file("sdk/src/Module/EngineNaming.php").contents
    assertContains(portedNaming, "Copyright (c) 2018 Ma_124", "the generated SDK should keep the strcase copyright")
    assertContains(portedNaming, "Permission is hereby granted", "the generated SDK should keep the strcase permission notice")
    assertContains(generated.file("sdk/LICENSE").contents, "Apache License", "the generated SDK should keep its own license")
    null
  }

  """
  generateScope on an existing module changes files under the scope only, not
  one module path deeper, and the scope stays the cwd.

  The module has a manifest only, so generation seeds the template, as the PHP
  runtime would, and moves the module to the entrypoint. The same module with a
  source directory is refused, and the refusal names the README's migration.
  """
  pub generateExistingModuleCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    let generated = phpSdk.generateScope(
      root.asWorkspace(cwd: rootingModulePath),
      isModule: true,
      name: "rooting-app",
      clients: [],
    )
    let changes = generated.directory("/").changes(root)
    let paths = changes.addedPaths + changes.modifiedPaths + changes.removedPaths

    assert(cwdOf(generated) == rootingModulePath, "generateScope changed the workspace cwd")
    assert(changes.addedPaths.length > 0, "generating a PHP module should add files")
    assert(
      paths.filter { path => path.hasPrefix(rootingModulePath + "/") == false }.length == 0,
      "generateScope changed files outside the scope",
    )
    assert(
      paths.filter { path => path.hasPrefix(rootingModulePath + "/" + fixtureRoot) }.length == 0,
      "generated files landed one module path deeper than the scope",
    )
    assert(contains(changes.addedPaths, rootingModulePath + "/composer.json"), "a module without a composer.json should be seeded")
    assert(contains(changes.addedPaths, rootingModulePath + "/src/RootingApp.php"), "the seeded template should name the module's class")
    assertContains(generated.file("dagger-module.toml").contents, "source = \"./sdk/entrypoint\"", "a seeded module should move to the entrypoint")

    let manifest = rootingModulePath + "/dagger-module.toml"
    let withSource = ws.withNewFile("/" + manifest, "source = \"./php\"\n" + contentsOf(ws, manifest))
    let refusal = generationError(withSource, path: rootingModulePath, name: "rooting-app")
    assertContains(refusal, "is on the PHP runtime, which this SDK no longer generates, and cannot move to the generated entrypoint: its source is php", "a module with a source directory should be refused")
    assertContains(refusal, "See \"Migrate from the built-in PHP runtime\" in the php-sdk README", "the refusal should name the migration")
    null
  }

  """
  A scope without a module and without clients is left unchanged. A module's
  clients generate into sdk/generated/Clients, a second generation changes
  nothing, and a removed client's files go. A refused generation returns no
  workspace, so it changes nothing. A direct generation, which does not know the
  clients, refuses a module that has some. The client type in a function
  signature is refused by the entrypoint describer, which the unit tests cover.
  A program, a scope without a module, gets its clients the same way and the
  Composer wiring, keeps them after a second generation, and keeps its core
  once its last client is removed.
  """
  pub generateClientScopeCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    # A workspace opened from Git, as on CI, would make these fixtures Git clients.
    let local = root.asWorkspace
    let generated = phpSdk.generateScope(
      root.asWorkspace(cwd: layeringModulePath),
      isModule: false,
      name: "layering",
      clients: [],
    )

    assert(cwdOf(generated) == layeringModulePath, "generateScope changed the workspace cwd")
    assert(generated.directory("/").changes(root).isEmpty, "a scope without a module or clients should not change")

    let lister = local.moduleSource("/" + clientTargetPath)
    let maker = local.moduleSource("/" + clientMakerPath)
    let clientsDir = entrypointModulePath + "/sdk/generated/Clients"
    let both = generatedEntrypoint(local, clients: [lister, maker])
    let entry = contentsOf(both, clientsDir + "/FileLister/Client.php")
    assertContains(entry, "namespace Dagger\\Clients\\FileLister;", "a client should generate into its namespace")
    assertContains(entry, "function fileLister(", "the entry class should have the target's constructor")
    assertContains(entry, "ModuleTarget('/" + clientTargetPath + "', null)", "a local client should serve its module from the workspace root, without a pin")
    assert(exists(both, clientsDir + "/FileLister/FileLister.php"), "the client's type should be generated")
    assert(exists(both, clientsDir + "/FileMaker/Client.php"), "every client should be generated")
    assert(exists(both, entrypointModulePath + "/sdk/generated/Client.php"), "core should still be generated")
    assert(exists(both, entrypointModulePath + "/sdk/generated/FileLister.php") == false, "core should not hold a client's types")
    assert(generatedEntrypoint(both, clients: [lister, maker]).changes(both).isEmpty, "a second generation with clients changed the module")
    let fewer = generatedEntrypoint(both, clients: [lister])
    assert(exists(fewer, clientsDir + "/FileMaker") == false, "a removed client's files should go")
    assert(exists(fewer, clientsDir + "/FileLister/Client.php"), "the remaining client should stay")
    assert(exists(generatedEntrypoint(both), clientsDir) == false, "removing every client should remove generated/Clients")
    let direct = phpSdk.mod(both, path: entrypointModulePath, findUp: false).generated.cwd rescue {
      err: Error => err.message
    }
    assertContains(direct, "has module clients, which only its scope in dagger.toml lists: run dagger generate", "a direct generation should not drop the clients")

    let plain = phpSdk.generateScope(root.asWorkspace(cwd: layeringModulePath), isModule: false, name: "layering", clients: [lister]).cwd rescue {
      err: Error => err.message
    }
    assertContains(plain, "has no composer.json, which autoloads its clients: create one with composer init, or remove the clients file-lister", "a client in a scope without a module or composer.json should be refused")

    let programSdk = programPath + "/sdk/generated"
    let program = generatedProgram(local, [lister])
    assert(exists(program, programSdk + "/Clients/FileLister/Client.php"), "a program's client should be generated")
    assert(exists(program, programSdk + "/Client.php"), "a program's core should be generated")
    let composer = contentsOf(program, programPath + "/composer.json")
    assertContains(composer, "\"url\": \"./sdk\"", "a program should get the path repository ./sdk")
    assertContains(composer, "\"dagger/dagger\": \"*@dev\"", "a program should require dagger/dagger")
    assertContains(composer, "\"extra\": {\"keep\": true}", "a program's other keys should be kept, with their formatting")
    let lock = contentsOf(program, programPath + "/composer.lock")
    assert(lock.containsMatch("\"name\": \"dagger/dagger\",[^}]*\"dist\": \\{\\s*\"type\": \"path\",\\s*\"url\": \"\\./sdk\""), "a program's composer.lock should install dagger/dagger from ./sdk")
    phpSdk.mod(local, path: entrypointModulePath, findUp: false).phpContainer
      .withDirectory("/program", program.directory("/" + programPath, include: ["composer.json", "composer.lock"]))
      .withWorkdir("/program")
      .withExec(["composer", "validate", "--no-check-publish"])
      .sync
    assert(generatedProgram(program, [lister]).changes(program).isEmpty, "a second generation of a program changed it")
    let emptied = generatedProgram(program, [])
    assert(exists(emptied, programSdk + "/Clients") == false, "removing a program's last client should remove generated/Clients")
    assert(exists(emptied, programSdk + "/Client.php"), "removing a program's last client should keep its core")
    assertContains(contentsOf(emptied, programPath + "/composer.json"), "\"dagger/dagger\": \"*@dev\"", "removing a program's last client should keep its Composer wiring")
    let namedRepository = local.withNewFile("/" + programPath + "/composer.json", "{\"repositories\": {\"dagger-sdk\": {\"type\": \"vcs\", \"url\": \"https://example.com/x.git\"}}}\n")
    let taken = generatedProgram(namedRepository, [lister]).cwd rescue {
      err: Error => err.message
    }
    assertContains(taken, "names a Composer repository dagger-sdk, which composer config would replace with ./sdk", "a program's own repository named dagger-sdk should be refused")

    let manifest = entrypointModulePath + "/dagger-module.toml"
    let runtime = generationError(local.withNewFile("/" + manifest, "disableDefaultFunctionCaching = true\n" + contentsOf(local, manifest)), clients: [lister])
    assertContains(runtime, "cannot move to the generated entrypoint: it sets disableDefaultFunctionCaching", "a module on the PHP runtime that cannot move should be refused, with or without clients")
    let onTarget = local.withNewFile("/" + manifest, contentsOf(local, manifest).replace("v1.0.0-beta.21", target))
    let itself = generationError(onTarget, clients: [lister, onTarget.moduleSource("/" + entrypointModulePath)])
    assertContains(itself, "declares itself as the client entrypoint-app", "a client of the scope's own module should be refused")
    let renamed = local
      .withNewFile("/" + clientTargetPath + "/dagger-module.toml", "name = \"FileLister\"\nengineVersion = \"v1.0.0-beta.27\"\n\n[runtime]\n  source = \"dang\"\n")
      .moduleSource("/" + clientTargetPath)
    assertContains(generationError(local, clients: [lister, renamed]), "has the clients file-lister and FileLister, which generate into one PHP namespace", "clients whose namespaces differ only in case should be refused")
    let acrossCut = local
      .withNewFile("/" + clientMakerPath + "/dagger-module.toml", "name = \"file-maker\"\nengineVersion = \"v1.0.0-beta.25\"\n\n[runtime]\n  source = \"dang\"\n")
      .moduleSource("/" + clientMakerPath)
    assertContains(generationError(local, clients: [acrossCut]), "generates for " + target + " and has the client file-maker, which declares v1.0.0-beta.25, across the identifier-casing cut at v1.0.0-beta.26", "a client module on the other side of the identifier-casing cut from the target should be refused")
    let programCut = generatedProgram(local, [acrossCut]).cwd rescue {
      err: Error => err.message
    }
    assertContains(programCut, "generates for " + target + " and has the client file-maker, which declares v1.0.0-beta.25", "a program's client module on the other side of the identifier-casing cut from the target should be refused")
    let programComposer = "/" + programPath + "/composer.json"
    let missing = generatedProgram(local.withNewFile(programComposer, "{\"repositories\": [{\"type\": \"path\", \"url\": \"../missing\"}]}\n"), [lister]).cwd rescue {
      err: Error => err.message
    }
    assertContains(missing, "reads ../missing outside it, which holds no file in the workspace", "a program's missing Composer path outside it should be refused")
    let bootstrap = local
      .withNewFile("/" + fixtureRoot + "/client-target/bootstrap.php", "<?php\n")
      .withNewFile(programComposer, "{\"autoload\": {\"files\": [\"../bootstrap.php\"]}}\n")
    assertContains(contentsOf(generatedProgram(bootstrap, [lister]), programPath + "/composer.json"), "../bootstrap.php", "a program with an autoload file outside it should generate")
    null
  }

  """
  A module calls its two dependencies as clients through dagger call, from its
  own code: a core Directory that one client returns reaches the other. A program installed with
  Composer does the same in a nested session, whose local addresses resolve in
  this module's tree.
  """
  pub unifiedClientCallCheck(ws: Workspace!): Void @check {
    let tree = directory
      .withDirectory("caller", ws.directory("/" + clientCallerPath))
      .withDirectory("lister", ws.directory("/" + clientTargetPath))
      .withDirectory("maker", ws.directory("/" + clientMakerPath))
    let scope = tree.asWorkspace(cwd: "caller")
    let lister = scope.moduleSource("/lister")
    let generated = phpSdk.generateScope(scope, isModule: true, name: "caller", clients: [lister, scope.moduleSource("/maker")])
    assertNotContains(generated.file("/caller/dagger-module.toml").contents, "[[dependencies]]", "the caller's dependencies should become clients")
    let app = callClient
      .withDirectory("/work", generated.directory("/"))
      .withWorkdir("/work")
      .withExec(["git", "init", "--quiet"])
      .withWorkdir("/work/caller")
    let listed = call(app, ["call", "list-made"])
    assert(listed.trimSpace == "a.html,b.html", "the module should list what one client made with the other: " + listed)

    # A workspace opened from Git, as on CI, would make these fixtures Git clients.
    let local = ws.directory("/").asWorkspace
    let program = generatedProgram(local, [local.moduleSource("/" + clientTargetPath), local.moduleSource("/" + clientMakerPath)])
    let printed = phpSdk.mod(ws, path: entrypointModulePath, findUp: false).phpContainer
      .withDirectory("/program", program.directory("/" + programPath))
      .withWorkdir("/program")
      .withExec(["composer", "install", "--no-dev"])
      .withEnvVariable("DAGGER_CLIENT_VERSION", target)
      .withExec(["php", "main.php"], experimentalPrivilegedNesting: true)
      .stdout
    assert(printed.trimSpace == "a.html,b.html", "the program should list what one client made with the other: " + printed)
  }

  """
  The generated dang.toml and main.dang declare one target, at language 2.1, as
  text: this does not show that an engine reads either. Generation keeps what the
  user set, replaces an owned Dagger import, and refuses what it cannot preserve.
  The cwd survives and a second generation changes nothing.
  """
  pub entrypointConfigCheck(ws: Workspace!): Void @check {
    let generated = generatedEntrypoint(ws)
    let config = contentsOf(generated, entrypointConfigPath)
    assertContains(config, "dang = \"2.1\"", "the language should be 2.1")
    assertContains(config, "dagger = \"" + target + "\"", "the Dagger import should declare the target")
    assertContains(
      contentsOf(generated, entrypointModulePath + "/sdk/entrypoint/main.dang"),
      "\"DAGGER_CLIENT_VERSION\", \"" + target + "\"",
      "the process should declare the version dang.toml declares",
    )
    assert(
      cwdOf(phpSdk.generateScope(ws.withWorkdir(entrypointModulePath), isModule: true, name: entrypointName, clients: [])) == entrypointModulePath,
      "generateScope changed the workspace cwd",
    )
    assertNoChange(generated, "a generated module")

    let settings = "dang = \"2.1\"\n\n[imports.Dagger]\ndagger = true\n\n[imports.Other]\npath = \"../../other\"\n"
    let preserved = generatedEntrypoint(withConfig(generated, settings))
    let rewritten = contentsOf(preserved, entrypointConfigPath)
    assertContains(rewritten, "dagger = \"" + target + "\"", "dagger = true should be replaced by the target")
    assertContains(rewritten, "[imports.Other]", "another import should be kept")
    assertContains(rewritten, "path = \"../../other\"", "another import's settings should be kept")
    assertNoChange(preserved, "a module with its own settings")

    let older = generatedEntrypoint(withConfig(generated, "[imports.Dagger]\ndagger = \"v1.0.0-beta.20\"\n"))
    assertContains(contentsOf(older, entrypointConfigPath), "dagger = \"" + target + "\"", "an older version should be replaced by the target")
    assertNotContains(contentsOf(older, entrypointConfigPath), "beta.20", "the older version should be gone")

    assertRefused(withConfig(generated, "dang = \"2.0\"\n"), "declares dang = 2.0", "another language")
    assertRefused(withConfig(generated, "[imports.Dagger]\npath = \"./dagger\"\n"), "gives the Dagger import a path", "a path on the Dagger import")
    assertRefused(
      withConfig(generated, "[imports.Dagger]\ndagger = true\nendpoint = \"https://example.com\"\n"),
      "endpoint",
      "an endpoint with a version",
    )
    assertRefused(
      withConfig(generated, "[imports.Other]\npath = \"./other\"\n"),
      "inside sdk/",
      "an import from inside the replaced sdk/",
    )
    let imported = generated.withNewFile("/" + entrypointModulePath + "/sdk/entrypoint/other/main.dang", "type Other {}\n")
    ["../../sdk/entrypoint/other", "../../sdk/lib", "../../other/../sdk", "../other"].each { path =>
      assertRefused(
        withConfig(imported, "[imports.Other]\npath = \"" + path + "\"\n"),
        "inside sdk/",
        "an import from " + path,
      )
    }
    assertRefused(
      withConfig(generated, "[imports.Other]\ndagger = \"v1.0.0-beta.20\"\n"),
      "pins the import Other",
      "another alias on another version",
    )

    let ancestor = entrypointModulePath + "/dang.toml"
    assertRefused(
      ws.withNewFile("/" + ancestor, "[imports.Other]\npath = \"./other\"\n"),
      "applies to the entrypoint",
      "a dang.toml above the entrypoint with settings of its own",
    )
    let plainAncestor = "dang = \"2.1\"\n\n[imports.Dagger]\ndagger = true\n"
    let beside = generatedEntrypoint(ws.withNewFile("/" + ancestor, plainAncestor))
    assert(contentsOf(beside, ancestor) == plainAncestor, "a dang.toml above the entrypoint should be left alone")
    assertContains(contentsOf(beside, entrypointConfigPath), target, "the entrypoint should get its own dang.toml")

    let sdkAncestor = entrypointModulePath + "/sdk/dang.toml"
    let keptSdkAncestor = generatedEntrypoint(generated.withNewFile("/" + sdkAncestor, plainAncestor))
    assert(contentsOf(keptSdkAncestor, sdkAncestor) == plainAncestor, "a dang.toml in sdk/ should survive replacing sdk/")

    let outside = generatedEntrypoint(ws.withNewFile("/" + fixtureRoot + "/entrypoint/dang.toml", "[imports.Other]\npath = \"./other\"\n"))
    assertContains(contentsOf(outside, entrypointConfigPath), target, "a dang.toml above the module does not apply to it")
    null
  }

  """
  What counts as this SDK's: the entrypoint path alone does not, so another SDK's
  entrypoint, a custom one, a runtime other than php and a stray dang.toml stay
  out of generation, which changes nothing for the first three.
  """
  pub entrypointOwnershipCheck(ws: Workspace!): Void @check {
    let generated = generatedEntrypoint(ws)
    let manifest = entrypointModulePath + "/dagger-module.toml"
    let build = entrypointModulePath + "/sdk/entrypoint/build.dang"

    assert(phpSdk.mod(generated, path: entrypointModulePath, findUp: false).ownsEntrypoint, "the generated entrypoint should be recognized")
    assert(phpSdk.mod(generated, path: entrypointModulePath + "/src").rootPath == entrypointModulePath, "find-up should recognize the generated entrypoint as PHP")

    let foreign = generated.withNewFile("/" + build, "type PythonModuleBuild {}\n")
    assert(phpSdk.mod(foreign, path: entrypointModulePath, findUp: false).ownsEntrypoint == false, "another SDK's entrypoint at the same path should not be recognized")
    assertNoChange(foreign, "another SDK's entrypoint")
    let lookup = phpSdk.mod(foreign, path: entrypointModulePath + "/src").rootPath rescue {
      err: Error => err.message
    }
    assertContains(lookup, "does not use the PHP SDK", "find-up should not take another SDK's entrypoint for PHP")

    let custom = generated.withNewFile("/" + manifest, "name = \"entrypoint-app\"\n\n[entrypoint]\nkind = \"dang\"\nsource = \"./custom\"\n")
    assertNoChange(custom, "a custom entrypoint")
    assertNoChange(generated.withNewFile("/" + manifest, "name = \"entrypoint-app\"\nengineVersion = \"" + target + "\"\n\n[runtime]\nsource = \"go\"\n"), "a module on a runtime other than php")

    assertRefused(
      ws.withNewFile("/" + entrypointConfigPath, "dang = \"2.1\"\n"),
      "was not written by this SDK",
      "a stray dang.toml in the entrypoint directory",
    )
    assertRefused(
      ws.withNewFile("/" + entrypointModulePath + "/sdk/notes.txt", "mine\n"),
      "is not the SDK's library",
      "a directory of the user's at sdk/",
    )
    null
  }

  """
  An eligible module moves to the entrypoint and keeps its settings. A module the
  entrypoint cannot run is refused, and no setting is dropped silently.
  """
  pub entrypointMigrationCheck(ws: Workspace!): Void @check {
    let manifest = entrypointModulePath + "/dagger-module.toml"
    let legacyJson = entrypointModulePath + "/dagger.json"
    let composer = entrypointModulePath + "/composer.json"
    let composerText = contentsOf(ws, composer)

    let migrated = generatedEntrypoint(ws)
    let written = contentsOf(migrated, manifest)
    assertContains(written, "source = \"./sdk/entrypoint\"", "the manifest should name the entrypoint")
    assertNotContains(written, "engineVersion", "only a runtime reads engineVersion")
    assertNotContains(written, "[runtime]", "the php runtime should be replaced")
    assert(contentsOf(migrated, composer) == composerText, "Composer settings should not change")
    assert(exists(migrated, entrypointModulePath + "/composer.lock"), "the lock should be written")
    assert(exists(migrated, entrypointModulePath + "/sdk/generated/Client.php"), "the client should be generated")
    assert(exists(migrated, entrypointModulePath + "/sdk/bin/dagger-module"), "the call command should be written")
    assert(exists(migrated, entrypointModulePath + "/sdk/tests") == false, "the SDK's tests are not for modules")

    let fromJson = ws
      .withoutFile("/" + manifest)
      .withNewFile("/" + legacyJson, "{\"name\": \"entrypoint-app\", \"engineVersion\": \"v1.0.0-0\", \"sdk\": {\"source\": \"php\"}}\n")
    let migratedJson = generatedEntrypoint(fromJson)
    assertContains(contentsOf(migratedJson, manifest), "source = \"./sdk/entrypoint\"", "a dagger.json module should move to the entrypoint")
    assert(exists(migratedJson, legacyJson) == false, "the dagger.json should be gone")

    let staleClass = migrated.withNewFile("/" + entrypointModulePath + "/sdk/generated/Obsolete.php", "<?php\n")
    assert(
      exists(generatedEntrypoint(staleClass), entrypointModulePath + "/sdk/generated/Obsolete.php") == false,
      "a client class the schema no longer has should go",
    )

    let nestedRule = generatedEntrypoint(ws.withNewFile("/" + entrypointModulePath + "/.gitignore", "/sdk/generated/\nbin/\n"))
    let nestedRules = contentsOf(nestedRule, entrypointModulePath + "/.gitignore")
    assertContains(nestedRules, "!/sdk/**\n", "a rule for a directory under sdk/ should be overridden")
    let tracked = nestedRule.directory(
      "/" + entrypointModulePath,
      include: ["sdk/generated/Client.php", "sdk/bin/dagger-module"],
      gitignore: true,
    )
    assert(tracked.exists("sdk/generated/Client.php"), "the client should be visible to Git")
    assert(tracked.exists("sdk/bin/dagger-module"), "the call command should be visible to Git")
    assertNoChange(nestedRule, "a module with rules under sdk/")

    let descendantsOnly = "/sdk/\n!/sdk/**\n/vendor/\n"
    let parentHidden = generatedEntrypoint(ws.withNewFile("/" + entrypointModulePath + "/.gitignore", descendantsOnly))
    assertContains(contentsOf(parentHidden, entrypointModulePath + "/.gitignore"), descendantsOnly + "!/sdk/\n!/sdk/**\n", "sdk/ itself should be re-included")
    assert(
      parentHidden.directory("/" + entrypointModulePath, include: ["sdk/bin/dagger-module"], gitignore: true).exists("sdk/bin/dagger-module"),
      "the call command should be visible to Git under an excluded parent",
    )
    assertNoChange(parentHidden, "a module with a re-included sdk/")

    let ignored = "*.log\n/sdk\n/vendor\n"
    let visible = generatedEntrypoint(ws.withNewFile("/" + entrypointModulePath + "/.gitignore", ignored))
    let rules = contentsOf(visible, entrypointModulePath + "/.gitignore")
    assert(rules.hasPrefix(ignored), "the user's ignore rules should stay as they are: " + rules)
    assertContains(rules, "!/sdk/\n!/sdk/**\n", "sdk/ should be visible to Git")
    assertNoChange(visible, "a module with its ignore rules")
    assertContains(contentsOf(migrated, entrypointModulePath + "/.gitignore"), "/vendor/", "vendor/ should be ignored")

    # findUp reads a host workspace from the host, so the marker needs a workspace
    # made of the directory that holds it.
    let locked = ws.directory("/").withNewFile(entrypointModulePath + "/.dagger-php-sdk-skip-generate", "").asWorkspace
    assert(phpSdk.mod(locked, path: entrypointModulePath, findUp: false).generate.isEmpty, "the skip marker should keep generation out")

    let lockAbove = ws.directory("/").withNewFile(fixtureRoot + "/entrypoint/.dagger-php-sdk-skip-generate", "").asWorkspace
    assert(phpSdk.mod(lockAbove, path: entrypointModulePath, findUp: false).skipGenerate, "a marker above the module should keep generation out")

    let fromRoot = phpSdk.mod(ws, path: entrypointModulePath, findUp: false).generate
    assert(contains(fromRoot.addedPaths, entrypointModulePath + "/sdk/entrypoint/main.dang"), "generating from the root should write the entrypoint")
    let fromModule = phpSdk.mod(ws.withWorkdir(entrypointModulePath), path: ".").generate
    assert(contains(fromModule.addedPaths, "sdk/entrypoint/main.dang"), "generating from the module should write the entrypoint relative to it")

    let kept = "name = \"entrypoint-app\"\nengineVersion = \"v1.0.0-beta.21\"\n\n[runtime]\nsource = \"php\"\n"
    let dependency = kept + "\n[[dependencies]]\nname = \"dep\"\nsource = \"../dep\"\n"
    assert(usesEntrypoint(ws), "the fixture should be eligible")
    assertContains(directError(ws.withNewFile("/" + manifest, dependency)), "a direct generation does not know the clients of its scope", "a direct generation of a module with dependencies should be refused")
    let several = "source = \"./php\"\ndisableDefaultFunctionCaching = true\n" + dependency.replace("v1.0.0-beta.21", "v1.1.0")
    assertMoveRefused(
      ws.withNewFile("/" + manifest, several),
      "a module with several reasons",
      "it has dependencies, and a direct generation does not know the clients of its scope, which provide them: run dagger generate; its engineVersion is later than v1.0.0-beta.27; it sets disableDefaultFunctionCaching; its source is php. See",
    )
    let filtered = "include = [\"src\", \"composer.json\", \"!src/tmp\"]\nexclude = [\"notes\"]\n" + kept
    assert(usesEntrypoint(ws.withNewFile("/" + manifest, filtered)), "a module with include and exclude patterns should be eligible")
    let translated = generatedEntrypoint(ws.withNewFile("/" + manifest, filtered))
    assertContains(contentsOf(translated, manifest), "\"!src/tmp\"", "the migrated manifest should keep the include patterns")
    assertContains(contentsOf(translated, manifest), "\"!notes\"", "an exclude entry should be kept as a negated include pattern")
    assertContains(contentsOf(translated, entrypointModulePath + "/sdk/entrypoint/main.dang"), "exclude: [\"src/tmp\", \"notes\"]", "the build should leave the excluded patterns out")
    assertNoChange(translated, "a module with include patterns")
    assertMoveRefused(ws.withNewFile("/" + manifest, "include = [\"!src/tmp\", \"src/tmp/keep\"]\n" + kept), "a pattern after an exclusion", "its include pattern src/tmp/keep includes again after an exclusion")
    assertMoveRefused(ws.withNewFile("/" + manifest, "include = [\"!../lib\"]\n" + kept), "an exclusion outside the module", "its include pattern !../lib excludes outside the module")
    assertMoveRefused(ws.withNewFile("/" + manifest, "include = [\"../lib/*.php\"]\n" + kept), "an outside glob", "its include pattern ../lib/*.php outside the module is a glob")
    assertMoveRefused(ws.withNewFile("/" + manifest, "exclude = [\"sdk\"]\n" + kept), "an exclusion of the generated sdk/", "its exclusion sdk drops files the generated entrypoint needs")
    assertMoveRefused(ws.withNewFile("/" + manifest, "include = [\"!composer.*\"]\n" + kept), "an exclusion of composer.json", "its exclusion composer.* drops files the generated entrypoint needs")
    assertMoveRefused(ws.withNewFile("/" + manifest, "include = [\"!!notes\"]\n" + kept), "an exclusion of a name that starts with !", "its include pattern !!notes excludes a name that starts with !")
    assertMoveRefused(ws.withNewFile("/" + manifest, "include = [\"!./!notes\"]\n" + kept), "an exclusion that normalizes to a name that starts with !", "its include pattern !./!notes excludes a name that starts with !")
    assertMoveRefused(ws.withNewFile("/" + manifest, "exclude = [\"sdk/entrypoint/types.dang\"]\n" + kept), "an exclusion of a generated entrypoint file", "its exclusion sdk/entrypoint/types.dang drops files")
    assertMoveRefused(ws.withNewFile("/" + manifest, "exclude = [\"sdk/src\"]\n" + kept), "an exclusion of the SDK library", "its exclusion sdk/src drops files")
    assertMoveRefused(ws.withNewFile("/" + manifest, "include = [\"!notes\", \"..\"]\n" + kept), "an ancestor of the module after an exclusion", "its include pattern .. includes again after an exclusion")
    let hidden = ws.withNewFile(
      "/" + entrypointModulePath + "/src/Hidden.php",
      "<?php\n\nnamespace DaggerModule;\n\n#[\\Dagger\\Attribute\\DaggerObject]\nclass Hidden\n{\n    #[\\Dagger\\Attribute\\DaggerFunction]\n    public function hidden(): string\n    {\n        return 'hidden';\n    }\n}\n",
    )
    let typesPath = entrypointModulePath + "/sdk/entrypoint/types.dang"
    let withAncestor = generatedEntrypoint(hidden.withNewFile("/" + manifest, "include = [\"..\"]\n" + kept))
    assertContains(contentsOf(withAncestor, typesPath), "\"Hidden\"", "the fixture class should be described without an exclusion")
    let ancestorExcluding = generatedEntrypoint(hidden.withNewFile("/" + manifest, "include = [\"..\", \"!src/Hidden.php\"]\n" + kept))
    assertNotContains(contentsOf(ancestorExcluding, typesPath), "\"Hidden\"", "an ancestor include should not bring back a file the module excludes")
    assertMoveRefused(ws.withNewFile("/" + manifest, "source = \"./php\"\n" + kept), "a module with another source", "its source is php")
    assert(usesEntrypoint(ws.withoutFile("/" + composer)), "a module without a composer.json should be eligible")
    let moduleClass = entrypointModulePath + "/src/EntrypointApp.php"
    let seeded = generatedEntrypoint(ws.withoutFile("/" + composer))
    let seededOutside = generatedEntrypoint(ws.withoutFile("/" + composer).withNewFile("/" + manifest, "include = [\"../../outside/extra\"]\n" + kept))
    assertContains(contentsOf(seededOutside, entrypointModulePath + "/sdk/entrypoint/main.dang"), "workspace.directory(\"../../outside/extra\"", "a seeded module should return its include directory outside it")
    assert(contentsOf(seeded, moduleClass) == contentsOf(ws, moduleClass), "the seeded template should keep the module's files")
    assertContains(generationError(ws.withoutFile("/" + composer), phpSdk(template: "missing")), "unknown init template: missing", "a module seeded from an unknown template")
    let initialized = generatedEntrypoint(ws.withoutFile("/" + manifest))
    assert(contentsOf(initialized, composer) == composerText, "a new module should keep its composer.json")
    assert(exists(initialized, entrypointModulePath + "/entrypoint.php") == false, "a new module with a composer.json should get no starter files")
    assertMoveRefused(ws.withNewFile("/" + manifest, kept.replace("v1.0.0-beta.21", "v1.1.0")), "a module on an engine later than the target", "its engineVersion is later than v1.0.0-beta.27")
    assert(usesEntrypoint(ws.withNewFile("/" + manifest, kept.replace("v1.0.0-beta.21", target))), "a module on the target engine should be eligible")
    assertMoveRefused(ws.withNewFile("/" + manifest, "disableDefaultFunctionCaching = true\n" + kept), "a module without default function caching", "it sets disableDefaultFunctionCaching")
    assert(usesEntrypoint(ws.withNewFile("/" + manifest, "disableDefaultFunctionCaching = false\n" + kept)), "a module with default function caching should be eligible")
    assertMoveRefused(ws.withNewFile("/" + manifest, kept + "\n[[clients]]\ngenerator = \"go\"\ndirectory = \"./client\"\n"), "a module with pre-v2 clients", "it declares clients")

    let absoluteAutoload = composerText.replace("\"src/\"", "\"/opt/src/\"")
    assertMoveRefused(ws.withNewFile("/" + composer, absoluteAutoload), "an absolute autoload path", "Composer reads /opt/src/ outside the module")
    # The fixture sits six directories below the workspace root, so seven ".."
    # leave the workspace.
    let escapingAutoload = composerText.replace("\"src/\"", "\"../../../../../../../src/\"")
    assertMoveRefused(ws.withNewFile("/" + composer, escapingAutoload), "an autoload path outside the workspace", "Composer reads ../../../../../../../src/ outside the module")
    let insideAutoload = composerText.replace("\"src/\"", "\"./lib/../src/\"")
    assert(usesEntrypoint(ws.withNewFile("/" + composer, insideAutoload)), "a path that stays in the module should not count as outside")
    assertMoveRefused(ws.withNewFile("/" + composer, composerText.replace("\"platform\"", "\"vendor-dir\": \"deps\", \"platform\"")), "a moved vendor-dir", "composer.json moves vendor-dir to deps")
    assert(installsFromComposerFiles(ws), "the fixture should install from its Composer files alone")
    let disabled = composerText.replace("\"repositories\": [", "\"repositories\": {\"unused\": false, \"sdk\":").replace("}\n  ],", "}\n  },")
    assert(installsFromComposerFiles(ws.withNewFile("/" + composer, disabled)) == false, "a module with another repository should install after its source")
    let scripts = composerText.replace("\"config\"", "\"scripts\": {\"post-install-cmd\": \"true\"}, \"config\"")
    assert(installsFromComposerFiles(ws.withNewFile("/" + composer, scripts)) == false, "a module with scripts should install after its source")
    let escaped = composerText.replace("\"url\": \"./sdk\"", "\"url\": \"./sdk\", \"\\u006fptions\": {\"symlink\": false}")
    assert(installsFromComposerFiles(ws.withNewFile("/" + composer, escaped)) == false, "a module with an escaped key should install after its source")
    let unwired = composerText
      .replace("  \"repositories\": [\n    {\n      \"type\": \"path\",\n      \"url\": \"./sdk\"\n    }\n  ],\n", "")
      .replace(",\n    \"dagger/dagger\": \"*@dev\"", "")
    let wired = generatedEntrypoint(ws.withNewFile("/" + composer, unwired))
    let wiredComposer = contentsOf(wired, composer)
    assertContains(contentsOf(wired, manifest), "source = \"./sdk/entrypoint\"", "a module without the ./sdk repository should move to the entrypoint")
    assertContains(wiredComposer, "\"url\": \"./sdk\"", "a module should get the path repository ./sdk")
    assertContains(wiredComposer, "\"dagger/dagger\": \"*@dev\"", "a module should require dagger/dagger")
    assertContains(wiredComposer, "\"php\": \"8.3.7\"", "a module's other Composer keys should be kept")
    assertContains(contentsOf(wired, entrypointModulePath + "/sdk/entrypoint/build.dang"), "\"--no-autoloader\"", "a module given the ./sdk repository should install from its Composer files alone")
    assertNoChange(wired, "a module given the ./sdk repository")

    let entrypointTable = "\n[entrypoint]\nkind = \"dang\"\nsource = \"./sdk/entrypoint\"\n"
    let unknownClients = "a direct generation does not know the clients of its scope"
    assertContains(directError(migrated.withNewFile("/" + manifest, dependency + entrypointTable)), unknownClients, "a direct generation of an entrypoint with dependencies and a runtime should be refused")
    let noRuntime = migrated.withNewFile("/" + manifest, "name = \"entrypoint-app\"\n\n[[dependencies]]\nname = \"dep\"\nsource = \"../dep\"\n" + entrypointTable)
    assertContains(directError(noRuntime), unknownClients, "a direct generation of an entrypoint with dependencies and no runtime should be refused")
    assertRefused(noRuntime, "add each client, or remove the dependency:\n  dagger module client add ../dep", "an entrypoint with a dependency that no client provides")

    let local = ws.directory("/").asWorkspace
    let lister = local.moduleSource("/" + clientTargetPath)
    let dependsOn = kept + "\n[[dependencies]]\n"
    let listerSource = "source = \"../../client-target/app\"\n"
    let named = local.withNewFile("/" + manifest, dependsOn + "name = \"file-lister\"\n" + listerSource)
    let fromDependency = generatedEntrypoint(named, clients: [lister])
    let dropped = contentsOf(fromDependency, manifest)
    assertContains(dropped, "source = \"./sdk/entrypoint\"", "a module whose dependencies are clients should move to the entrypoint")
    assertNotContains(dropped, "[[dependencies]]", "a dependency should become a client")
    assert(exists(fromDependency, entrypointModulePath + "/sdk/generated/Clients/FileLister/Client.php"), "the dependency's client should be generated")
    let aliased = generatedEntrypoint(local.withNewFile("/" + manifest, dependsOn + "name = \"Lister\"\nsource = \"../../client-target/app/\"\n"), clients: [lister])
    assertNotContains(contentsOf(aliased, manifest), "[[dependencies]]", "a dependency named by an alias should match its client by source")
    let unnamed = generatedEntrypoint(local.withNewFile("/" + manifest, dependsOn + listerSource), clients: [lister])
    assertNotContains(contentsOf(unnamed, manifest), "[[dependencies]]", "a dependency without a name should match its client by source")
    let keepsRuntime = generatedEntrypoint(migrated.withNewFile("/" + manifest, dependsOn + "name = \"file-lister\"\n" + listerSource + entrypointTable), clients: [lister])
    assertNotContains(contentsOf(keepsRuntime, manifest), "[[dependencies]]", "an entrypoint that names a runtime should lose the dependencies its clients provide")
    assertContains(contentsOf(keepsRuntime, manifest), "[runtime]", "an entrypoint that names a runtime should keep it")
    assertContains(
      generationError(local.withNewFile("/" + manifest, dependsOn + "name = \"file-lister\"\nsource = \"../../client-target/maker\"\n"), clients: [lister]),
      "add each client, or remove the dependency:\n  dagger module client add ../../client-target/maker",
      "a client with the dependency's name and another source should not provide it",
    )
    assertContains(generationError(named), "matching by source and Git version or pin, not by name", "a dependency that no client provides should be refused")
    let helpers = moduleSource("github.com/dagger/sdk-helpers@v1.0.9")
    let helpersSource = dependsOn + "source = \"github.com/dagger/sdk-helpers@v1.0.9\"\n"
    assertContains(generationError(local.withNewFile("/" + manifest, helpersSource.replace("v1.0.9", "v1.0.8")), clients: [helpers]), "  dagger module client add github.com/dagger/sdk-helpers@v1.0.8", "a Git dependency at another version than its client should be refused")
    let helpersPin = "daffbc01a1b3f3df7b1c417a7d2c83cd06d1bd33"
    [
      [helpersSource, "a Git dependency equal to its client"],
      [dependsOn + "source = \"https://github.com/dagger/sdk-helpers.git@v1.0.9\"\n", "an https:// ref ending in .git"],
      [dependsOn + "source = \"git@github.com:dagger/sdk-helpers@v1.0.9\"\n", "an SSH ref"],
      [dependsOn + "source = \"ssh://git@github.com:22/dagger/sdk-helpers@v1.0.9\"\n", "an ssh:// ref with a port"],
      [dependsOn + "source = \"GitHub.com/dagger/sdk-helpers@v1.0.9\"\npin = \"" + helpersPin + "\"\n", "a ref with another host case at its client's pin"],
    ].each { case =>
      let provided = generatedEntrypoint(local.withNewFile("/" + manifest, case[0] ?? ""), clients: [helpers])
      assertNotContains(contentsOf(provided, manifest), "[[dependencies]]", (case[1] ?? "") + " should be provided by its client")
      assert(exists(provided, entrypointModulePath + "/sdk/generated/Clients/SdkHelpers/Client.php"), (case[1] ?? "") + " should get its client generated")
      null
    }
    assertContains(
      generationError(local.withNewFile("/" + manifest, dependsOn + "source = \"github.com/dagger.git/sdk-helpers@v1.0.9\"\n"), clients: [helpers]),
      "  dagger module client add github.com/dagger.git/sdk-helpers@v1.0.9",
      "a subdirectory of another repository should not be provided by a client of the same path",
    )
    assertContains(
      generationError(local.withNewFile("/" + manifest, helpersSource + "pin = \"0000000000000000000000000000000000000000\"\n"), clients: [helpers]),
      "  dagger module client add github.com/dagger/sdk-helpers@0000000000000000000000000000000000000000",
      "a Git dependency pinned to another commit than its client should be refused, with its pin",
    )
    assertContains(generationError(local.withNewFile("/" + manifest, dependsOn + "source = \"github.com/dagger/sdk-helpers#v1.0.9\"\n"), clients: [helpers]), "no client of its scope", "a ref with a selector should be refused")
    assertContains(
      generationError(local.withNewFile("/" + manifest, dependsOn + "name = \"sdk-helpers\"\nsource = \"../expected\"\n"), clients: [helpers]),
      "  dagger module client add ../expected",
      "a local dependency should not be provided by a Git client of the same name",
    )
    let legacyStrings = ws
      .withoutFile("/" + manifest)
      .withNewFile("/" + legacyJson, "{\"name\": \"entrypoint-app\", \"engineVersion\": \"v1.0.0-0\", \"sdk\": {\"source\": \"php\"}, \"dependencies\": [\"github.com/acme/dep@v1\"]}\n")
    assertContains(generationError(legacyStrings), "  dagger module client add github.com/acme/dep@v1", "a dependency written as a source string should be read as its source")
    assertRefused(
      migrated.withNewFile("/" + composer, absoluteAutoload),
      "cannot keep its generated entrypoint",
      "a generated entrypoint with an absolute Composer path",
    )
    assertRefused(
      migrated.withNewFile("/" + manifest, "include = [\"!../lib\"]\nname = \"entrypoint-app\"\n" + entrypointTable),
      "its include pattern !../lib excludes outside the module",
      "a generated entrypoint with an include pattern it cannot translate",
    )
    assertRefused(
      migrated.withNewFile("/" + manifest, "disableDefaultFunctionCaching = true\nname = \"entrypoint-app\"\n" + entrypointTable),
      "it sets disableDefaultFunctionCaching",
      "a generated entrypoint without default function caching",
    )

    let encoding = "<?php\n\nnamespace DaggerModule;\n\n#[\\Dagger\\Attribute\\DaggerObject]\nenum Encoding\n{\n    case Base64;\n    case BASE64;\n}\n"
    let collision = generatedEntrypoint(ws.withNewFile("/" + entrypointModulePath + "/src/Encoding.php", encoding)).cwd rescue {
      err: GraphQLError => err.message + "\n" + err.extensions
    }
    assertContains(collision, "its cases Base64 and BASE64 the same name, BASE64", "cases the engine names alike should be refused, on an engine that serves naming (v1.0.0-beta.26+)")

    let fat = kept + entrypointTable
    let keptRuntime = contentsOf(generatedEntrypoint(migrated.withNewFile("/" + manifest, fat)), manifest)
    assertContains(keptRuntime, "[runtime]", "a runtime named beside a generated entrypoint should be kept for older engines")
    null
  }

  """
  The dagger CLI of the engine running the check, from the release's image, with
  the image's git. The image's entrypoint would start an engine, so it is removed.
  """
  let callClient: Container! {
    container
      .from("registry.dagger.io/engine:" + (version.split("+")[0] ?? version))
      .withoutEntrypoint
  }

  let call(ctr: Container!, args: [String!]!): String! {
    ctr.withExec(["dagger", "-m", "."] + args, experimentalPrivilegedNesting: true).stdout
  }

  """
  The generated entrypoint answers calls from a local and from a Git source:
  constructor, state, enums, nested and empty lists, IDs, omitted values,
  one function per role, and an error that keeps its message. A module that
  excludes files does not see them.
  """
  pub generatedEntrypointCallCheck(ws: Workspace!): Void @check {
    assertCalls(generatedEntrypoint(ws).directory("/" + entrypointModulePath))

    let manifest = entrypointModulePath + "/dagger-module.toml"
    let excluding = ws
      .withNewFile("/" + manifest, "exclude = [\"notes\"]\n" + contentsOf(ws, manifest))
      .withNewFile("/" + entrypointModulePath + "/notes/hidden.txt", "hidden\n")
    let filtered = callClient
      .withDirectory("/work/app", generatedEntrypoint(excluding).directory("/" + entrypointModulePath))
      .withWorkdir("/work/app")
      .withExec(["git", "init", "--quiet"])
    assertContains(call(filtered, ["call", "has-file", "--path", "notes/hidden.txt"]), "false", "an excluded file should not reach the module")
    assertContains(call(filtered, ["call", "has-file", "--path", "composer.json"]), "true", "a file the patterns keep should reach the module")

    assertTemplateCalls(
      phpSdk.generateScope(ws.withWorkdir(layeringModulePath), isModule: true, name: "layering", clients: [])
        .withWorkdir(".")
        .directory("/" + layeringModulePath),
    )
  }

  """
  The outside fixture with its path repository ../lib replaced by path.
  """
  let outsideWith(ws: Workspace!, path: String!): Workspace! {
    let composer = outsideModulePath + "/composer.json"
    ws.withNewFile("/" + composer, contentsOf(ws, composer).replace("\"../lib\"", "\"" + path + "\""))
  }

  """
  A module whose Composer path repository and autoload root sit outside its
  directory moves to the entrypoint, whose sources returns them: a call reads
  both, and an edit outside the module reaches the next call. An include
  directory outside the module reaches the call too. A path sources
  cannot return is refused. A file outside the module, a path with a ".." after
  a name, and the workspace root are refused.
  """
  pub entrypointOutsidePathsCheck(ws: Workspace!): Void @check {
    let outside = fixtureRoot + "/outside"
    let composer = outsideModulePath + "/composer.json"
    let composerText = contentsOf(ws, composer)
    let generated = generatedEntrypoint(ws, path: outsideModulePath, name: "outside-app")
    assertNotContains(contentsOf(generated, outsideModulePath + "/dagger-module.toml"), "[runtime]", "the module should move to the entrypoint")
    assertContains(contentsOf(generated, outsideModulePath + "/sdk/entrypoint/main.dang"), "workspace.directory(\"../shared/src\"", "sources should return the autoload root")

    # The engine reads a local module's context from its Git root, which must
    # hold the directories outside the module.
    let local = callClient
      .withDirectory("/work", generated.directory("/" + outside))
      .withWorkdir("/work")
      .withExec(["git", "init", "--quiet"])
      .withWorkdir("/work/app")
    assertContains(call(local, ["call", "greet"]), "hello from lib!", "the call should read the path repository and the autoload root")
    let edited = local.withExec(["sed", "-i", "s/hello from lib/hello again/", "/work/lib/src/Greeting.php"])
    assertContains(call(edited, ["call", "greet"]), "hello again!", "an edit outside the module should reach the next call")

    # From v1.0.0-beta.26 a lone include replaces sources, so the call only
    # passes if the manifest's include also lists the Composer paths.
    let manifest = outsideModulePath + "/dagger-module.toml"
    let including = generatedEntrypoint(ws.withNewFile("/" + manifest, "include = [\"!notes\", \"../extra\"]\n" + contentsOf(ws, manifest)), path: outsideModulePath, name: "outside-app")
    assertContains(contentsOf(including, manifest), "\"../lib\"", "include should list the Composer paths outside the module")
    assert(
      generatedEntrypoint(including, path: outsideModulePath, name: "outside-app").changes(including).isEmpty,
      "a second generation with exclusions and Composer paths outside the module changed it",
    )
    [
      ["../lib/composer.json", "it reads the file ../lib/composer.json outside the module"],
      ["../lib/*.php", "outside the module is a glob"],
      ["../../../../../../", "outside the module cannot be loaded from the workspace"],
    ].each { case =>
      let pattern = case[0] ?? ""
      let changed = ws.withNewFile("/" + manifest, "include = [\"" + pattern + "\"]\n" + contentsOf(ws, manifest))
      assertMoveRefused(changed, "the include pattern " + pattern, case[1] ?? "", outsideModulePath)
      null
    }
    let withInclude = callClient
      .withDirectory("/work", including.directory("/" + outside))
      .withWorkdir("/work")
      .withExec(["git", "init", "--quiet"])
      .withWorkdir("/work/app")
    assertContains(call(withInclude, ["call", "greet"]), "hello from lib!", "a module with include should still read its Composer paths")
    assertContains(call(withInclude, ["call", "extra"]), "extra note", "an include directory outside the module should reach the call")

    [
      ["../missing", "holds no file in the workspace", "a path that holds no file"],
      ["../linked", "goes through the symlink", "a path through a symlink"],
    ].each { case =>
      let changed = ws
        .withDirectory("/" + outside, directory.withSymlink("lib", "linked"))
        .withNewFile("/" + composer, composerText.replace("\"../lib\"", "\"" + (case[0] ?? "") + "\""))
      assertContains(generationError(changed, path: outsideModulePath, name: "outside-app"), case[1] ?? "", (case[2] ?? "") + " should be refused")
      null
    }
    assertMoveRefused(outsideWith(ws, "../lib/composer.json"), "a Composer path to a file outside the module", "it reads the file ../lib/composer.json outside the module", outsideModulePath)
    assertMoveRefused(outsideWith(ws, "../bridge/../lib"), "a path with a .. after a name", "Composer reads ../bridge/../lib outside the module", outsideModulePath)
    assertMoveRefused(outsideWith(ws, "../../../../../../"), "a path to the workspace root", "Composer reads ../../../../../../ outside the module", outsideModulePath)
    let ignored = ws.withNewFile("/" + outside + "/lib/.gitignore", "*\n")
    assertContains(generationError(ignored, path: outsideModulePath, name: "outside-app"), "holds no file that .gitignore keeps", "a path that .gitignore empties should be refused")
    null
  }

  """
  A Dang module passes objects of a third module to a PHP function that takes
  the PHP module's interface, alone and in a list, and gets them back, through
  dagger call. Loaded
  under another name, the PHP module refuses the interface, which the engine
  then names after that name.
  """
  pub entrypointInterfaceCallCheck(ws: Workspace!): Void @check {
    let generated = phpSdk.generateScope(ws.withWorkdir(interfacesPath + "/geometry"), isModule: true, name: "geometry", clients: [])
    let app = callClient
      .withDirectory("/work", generated.withWorkdir(".").directory("/" + interfacesPath))
      .withWorkdir("/work")
      .withExec(["git", "init", "--quiet"])
      .withWorkdir("/work/caller")
    let described = call(app, ["call", "describe"])
    assert(described.trimSpace == "square 18;square,circle", "the PHP module should query the caller's objects through its interface: " + described)
    let returned = call(app, ["call", "returned"])
    assert(returned.trimSpace == "circle;circle,square", "the PHP module should return the caller's objects through its interface: " + returned)

    let aliased = app
      .withWorkdir("/work/alias")
      .withExec(["dagger", "-m", ".", "call", "describe"], experimentalPrivilegedNesting: true, expect: ReturnType.FAILURE)
      .stderr
    assertContains(aliased, "as a dependency alias, cannot take its interfaces yet", "a module loaded under another name should refuse its interface")
  }

  """
  A pinned targetVersion reaches dang.toml and the entrypoint's
  DAGGER_CLIENT_VERSION through generateScope and a direct mod, and stays there
  on a second generation. A direct mod without the setting reads the pin
  dagger.toml records for the module's scope, at any equivalent path, and the
  setting wins over it. Records the engine refuses are refused. A
  release later than the SDK's target is refused on both paths, and so is a
  pinned module on the PHP runtime that cannot move to the entrypoint.
  """
  pub targetVersionCheck(ws: Workspace!): Void @check {
    let pinned = "v1.0.0-beta.24"
    let sdk = phpSdk(targetVersion: pinned)
    let generated = generatedEntrypoint(ws, sdk)
    let direct = ws.withChanges(sdk.mod(ws, path: entrypointModulePath, findUp: false).generate)
    let recording = recordedScope(ws, "./" + entrypointModulePath + "/", pinned)
    let fromRecord = recording.withChanges(phpSdk.mod(recording, path: entrypointModulePath, findUp: false).generate)
    [generated, direct, fromRecord].each { out =>
      assertContains(contentsOf(out, entrypointConfigPath), "dagger = \"" + pinned + "\"", "dang.toml should declare the pinned target")
      assertContains(
        contentsOf(out, entrypointModulePath + "/sdk/entrypoint/main.dang"),
        "\"DAGGER_CLIENT_VERSION\", \"" + pinned + "\"",
        "the entrypoint should declare the pinned target",
      )
    }
    assert(generatedEntrypoint(generated, sdk).changes(generated).isEmpty, "a second pinned generation changed the module")
    let later = phpSdk(targetVersion: "v1.0.0-beta.28")
    let refusal = "pins targetVersion v1.0.0-beta.28, which this release of the PHP SDK cannot generate for"
    assertContains(generationError(ws, later), refusal, "a later release should be refused")
    let directRefused = later.mod(ws, path: entrypointModulePath, findUp: false).rootPath rescue { err: Error => err.message }
    assertContains(directRefused, refusal, "a later release should be refused on a direct mod")
    let recordedLater = recordedScope(ws, "/" + entrypointModulePath, "v1.0.0-beta.28")
    let recordedRefused = phpSdk.mod(recordedLater, path: entrypointModulePath, findUp: false).rootPath rescue { err: Error => err.message }
    assertContains(recordedRefused, refusal, "a later recorded release should be refused on a direct mod")
    let equivalent = phpSdk.mod(recordedLater, path: "tmp/../" + entrypointModulePath, findUp: false).rootPath rescue { err: Error => err.message }
    assertContains(equivalent, "pins targetVersion v1.0.0-beta.28", "a pin recorded for an equivalent path should apply")
    let conflicting = recordedScope(recordedLater, "./" + entrypointModulePath, pinned)
    let conflict = phpSdk.mod(conflicting, path: entrypointModulePath, findUp: false).rootPath rescue { err: Error => err.message }
    assertContains(conflict, "records several targetVersion settings", "equivalent scope keys with different pins should be refused")
    let escaping = phpSdk.mod(recordedScope(ws, "../outside", pinned), path: entrypointModulePath, findUp: false).rootPath rescue { err: Error => err.message }
    assertContains(escaping, "escapes the workspace root", "a scope key outside the workspace should be refused")
    assert(sdk.mod(recordedLater, path: entrypointModulePath, findUp: false).rootPath == entrypointModulePath, "the targetVersion setting should win over the recorded one")
    let elsewhere = recordedScope(ws, fixtureRoot + "/entrypoint", "v1.0.0-beta.28")
    assert(phpSdk.mod(elsewhere, path: entrypointModulePath, findUp: false).rootPath == entrypointModulePath, "a pin recorded for another scope should not apply")
    let manifest = entrypointModulePath + "/dagger-module.toml"
    let kept = generationError(ws.withNewFile("/" + manifest, "disableDefaultFunctionCaching = true\n" + contentsOf(ws, manifest)), sdk)
    assertContains(kept, "cannot move to the generated entrypoint: it sets disableDefaultFunctionCaching", "a pinned module on the PHP runtime that cannot move should be refused")
  }

  """
  The workspace with dagger.toml recording a targetVersion for the scope at key,
  in the SDK entry that names php-sdk as its module.
  """
  let recordedScope(ws: Workspace!, key: String!, version: String!): Workspace! {
    let config = contentsOf(ws, "dagger.toml")
    let entry = if (config.contains("[sdks.php]")) { "" } else { "\n[sdks.php]\nmodule = \"php-sdk\"\n" }
    let record = entry + "\n[sdks.php.scopes.\"" + key + "\"]\nis-module = true\n\n[sdks.php.scopes.\"" + key + "\".settings]\ntargetVersion = \"" + version + "\"\n"
    ws.withNewFile("/dagger.toml", config + record)
  }

  """
  The default new-module path: a module from the minimal template has neither
  fields nor a constructor of its own, and calls the engine from its function.
  """
  let assertTemplateCalls(module: Directory!): Void {
    let templated = callClient
      .withDirectory("/work/app", module)
      .withWorkdir("/work/app")
      .withExec(["git", "init", "--quiet"])
    assertContains(call(templated, ["call", "container-echo", "--string-arg", "from the template", "stdout"]), "from the template", "a main object without a constructor of its own should answer")
    null
  }

  let assertCalls(module: Directory!): Void {
    let local = callClient
      .withDirectory("/work/app", module)
      .withWorkdir("/work/app")
      .withExec(["git", "init", "--quiet"])

    assertContains(call(local, ["call", "greet"]), "hello world", "the omitted argument should take its default")
    assertContains(call(local, ["call", "--greeting", "hi", "greet", "--name", "you"]), "hi you", "the constructor and a given argument should reach the function")
    assertContains(call(local, ["call", "--levels", "Low,High", "last-level"]), "HIGH", "a list of enums should reach the state")
    assertContains(call(local, ["call", "with-level", "--level", "Low", "last-level"]), "LOW", "an enum should survive a call through the state")
    # On v1.0.0-beta.21 the CLI printed this nested list's elements as opaque
    # values, not its strings, so only the shape can be read back here.
    let grid = call(local, ["call", "grid", "--json"]).replaceMatches("\\s", "")
    assert(grid.containsMatch("^\\[\\[\"[^\"]+\",\"[^\"]+\"\\],\\[\\]\\]$"), "a nested list should keep its shape: " + grid)
    assertContains(call(local, ["call", "commas", "--json"]), "a,b", "a comma should stay inside its element")
    assertContains(call(local, ["call", "nothing", "--json"]), "[]", "an empty list should stay a list")
    assertContains(call(local, ["call", "entries", "--dir", "./src"]), "EntrypointApp.php", "a Directory ID should load")
    local.withExec(["dagger", "-m", ".", "check", "self-check"], experimentalPrivilegedNesting: true).sync
    assertContains(call(local, ["generate", "-l"]), "self-generate", "the generator should be listed")
    assertContains(call(local, ["start", "-l"]), "self-up", "the up function should be listed")
    assertContains(call(local, ["agent", "-l"]), "self-agent", "the agent should be listed")

    let failure = local
      .withExec(["dagger", "-m", ".", "call", "fail"], experimentalPrivilegedNesting: true, expect: ReturnType.FAILURE)
      .stderr
    assertContains(failure, "the fixture failed on purpose", "the function's error should reach the caller")

    let server = gitServer(module).asService
    let ref = gitAddress(server) + "@main"
    let remote = callClient
      .withServiceBinding(server.hostname, server)
      .withExec(["sh", "-c", "dagger -m \"" + ref + "\" call greet"], experimentalPrivilegedNesting: true)
      .stdout
    assertContains(remote, "hello world", "a module from a Git source should answer")
    null
  }

  """
  A Git daemon serving the module at repo.git, on branch main.
  """
  let gitServer(module: Directory!): Container! {
    container
      .from("alpine:3.22")
      .withoutEntrypoint
      .withExec(["apk", "add", "--no-cache", "git", "git-daemon"])
      .withDirectory("/srv/repo", module)
      .withWorkdir("/srv/repo")
      .withExec(["git", "init", "-q", "-b", "main"])
      .withExec(["git", "add", "-A"])
      .withExec(["git", "-c", "user.name=e2e", "-c", "user.email=e2e@example.com", "commit", "-q", "-m", "generated module"])
      .withExec(["git", "clone", "-q", "--bare", ".", "/srv/repo.git"])
      .withExposedPort(9418)
      .withDefaultArgs(["git", "daemon", "--export-all", "--base-path=/srv", "/srv"])
  }

  """
  The engine takes a Git ref whose host has no dot for a Go import path and
  refuses it, so the address names the server by its full name, in the session
  domain that resolv.conf searches last. A shell expands it.
  """
  let gitAddress(server: Service!): String! {
    "git://" + server.hostname + ".$(awk '/^search/ {print $NF}' /etc/resolv.conf)/repo.git"
  }

  """
  A client generated for a Dang module serves it and answers a PHP call that
  passes a core Directory: from a local path, and from Git at a pinned commit
  that main has moved past.
  """
  pub clientTargetCallCheck(ws: Workspace!): Void @check {
    let local = "/" + clientTargetPath
    let script = "<?php\nrequire 'vendor/autoload.php';\n" +
      "use Dagger\\Clients\\FileLister\\Client;\n" +
      "$dir = Dagger\\Dagger::getClientInstance()->directory()->withNewFile('a.txt', 'a')->withNewFile('b.txt', 'b');\n" +
      "echo Client::fileLister()->entries($dir), PHP_EOL;\n" +
      "echo Client::fileLister()->entries($dir->withNewFile('c.txt', 'c')), PHP_EOL;\n"
    let php = phpSdk.mod(ws, path: entrypointModulePath, findUp: false).phpContainer
      .withDirectory("/sdk", ws.directory("/sdk", exclude: ["vendor", "generated", ".cache"]))
      .withWorkdir("/sdk")
      .withExec(["composer", "install", "--no-dev"])
      .withMountedFile("/schema.json", ws.moduleSource(local).withEngineVersion(target).clientSchemaIntrospectionJSON)
      .withExec(["php", "scripts/codegen.php", "dagger:codegen", "--schema-file", "/schema.json", "--core"])
      .withNewFile("/sdk/call.php", script)
      .withEnvVariable("DAGGER_CLIENT_VERSION", target)
    let codegen = "php scripts/codegen.php dagger:codegen --schema-file /schema.json --client file-lister"
    let want = "a.txt,b.txt\na.txt,b.txt,c.txt\n"

    let fromPath = php
      .withExec(["sh", "-c", codegen + " --address " + local + " > /dev/null && php call.php"], experimentalPrivilegedNesting: true)
      .stdout
    assert(fromPath == want, "a client of a local module should list the directory it was passed: " + fromPath)

    let repo = gitServer(ws.directory(local))
    let pin = repo.withExec(["git", "-C", "/srv/repo.git", "rev-parse", "main"]).stdout.trimSuffix("\n")
    let server = repo
      .withExec(["sed", "-i", "s/join(\",\")/join(\";\")/", "main.dang"])
      .withExec(["git", "-c", "user.name=e2e", "-c", "user.email=e2e@example.com", "commit", "-qam", "list with semicolons"])
      .withExec(["git", "push", "-q", "/srv/repo.git", "main"])
      .asService
    let fromGit = php
      .withServiceBinding(server.hostname, server)
      .withExec(["sh", "-c", codegen + " --address \"" + gitAddress(server) + "@main\" --pin " + pin + " > /dev/null && php call.php"], experimentalPrivilegedNesting: true)
      .stdout
    assert(fromGit == want, "a client of a Git module should load its pinned commit, not the tip of main: " + fromGit)
  }

  """
  The unit tests of the entrypoint support, against a client of the target schema.
  """
  pub sdkUnitCheck(ws: Workspace!): Void @check {
    let mod = phpSdk.mod(ws, path: entrypointModulePath, findUp: false)
    mod.phpContainer
      .withDirectory("/sdk", ws.directory("/sdk", exclude: ["vendor", "generated", ".cache"]))
      .withWorkdir("/sdk")
      .withExec(["composer", "install"])
      .withMountedFile("/schema.json", mod.clientSchema)
      .withExec(["php", "scripts/codegen.php", "dagger:codegen", "--schema-file", "/schema.json"])
      .withExec(["vendor/bin/phpunit", "--group", "unit"])
      .sync
    null
  }

  """
  The PSR-12 style of the PHP library.
  """
  pub sdkStyleCheck(ws: Workspace!): Void @check {
    let mod = phpSdk.mod(ws, path: entrypointModulePath, findUp: false)
    mod.phpContainer
      .withDirectory("/sdk", ws.directory("/sdk", exclude: ["vendor", "generated", ".cache"]))
      .withWorkdir("/sdk")
      .withExec(["composer", "install"])
      .withExec(["vendor/bin/phpcs"])
      .sync
    null
  }

  """
  The PHPStan analysis of the PHP library, against a client of the target schema.
  """
  pub sdkAnalysisCheck(ws: Workspace!): Void @check {
    let mod = phpSdk.mod(ws, path: entrypointModulePath, findUp: false)
    mod.phpContainer
      .withDirectory("/sdk", ws.directory("/sdk", exclude: ["vendor", "generated", ".cache"]))
      .withWorkdir("/sdk")
      .withExec(["composer", "install"])
      .withMountedFile("/schema.json", mod.clientSchema)
      .withExec(["php", "scripts/codegen.php", "dagger:codegen", "--schema-file", "/schema.json"])
      .withExec(["vendor/bin/phpstan", "analyse", "--no-progress", "--memory-limit=1G"])
      .sync
    null
  }

  """
  The Composer metadata and PSR-4 layout of the PHP library, against a client of the target schema.
  """
  pub sdkComposerCheck(ws: Workspace!): Void @check {
    let mod = phpSdk.mod(ws, path: entrypointModulePath, findUp: false)
    mod.phpContainer
      .withDirectory("/sdk", ws.directory("/sdk", exclude: ["vendor", "generated", ".cache"]))
      .withWorkdir("/sdk")
      .withExec(["composer", "validate", "--strict"])
      .withExec(["composer", "install"])
      .withMountedFile("/schema.json", mod.clientSchema)
      .withExec(["php", "scripts/codegen.php", "dagger:codegen", "--schema-file", "/schema.json"])
      .withExec(["composer", "dump-autoload", "--classmap-authoritative", "--strict-psr", "--strict-ambiguous"])
      .sync
    null
  }

  """
  The codegen unit tests, against a committed schema that holds core and one client.
  """
  pub sdkCodegenUnitCheck(ws: Workspace!): Void @check {
    let mod = phpSdk.mod(ws, path: entrypointModulePath, findUp: false)
    mod.phpContainer
      .withDirectory("/sdk", ws.directory("/sdk", exclude: ["vendor", "generated", ".cache"]))
      .withWorkdir("/sdk")
      .withExec(["composer", "install"])
      .withExec(["vendor/bin/phpunit", "tests/Unit/Codegen"])
      .sync
    null
  }
}
