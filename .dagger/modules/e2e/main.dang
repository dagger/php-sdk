"""
End-to-end checks for the PHP SDK helper module.
"""
type E2e {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let lookupModulePath: String! = fixtureRoot + "/lookup/app"
  let lookupNestedPath: String! = lookupModulePath + "/nested"
  let tomlModulePath: String! = fixtureRoot + "/toml/app"
  let clientRootModulePath: String! = fixtureRoot + "/client-root/app"
  let layeringModulePath: String! = fixtureRoot + "/layering/app"
  let rootingModulePath: String! = fixtureRoot + "/rooting/app"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) { raise message }
    null
  }

  let contains(values: [String!]!, want: String!): Boolean! {
    values.filter { value => value == want }.length > 0
  }

  let cwdOf(ws: Workspace!): String! {
    ws.cwd.trimPrefix("/").trimSuffix("/")
  }

  """
  Lookup supports both config formats and chooses the nearest config regardless
  of filename ordering.
  """
  pub moduleLookupCheck(ws: Workspace!): Void @check {
    let nested = phpSdk.mod(ws, path: lookupNestedPath)
    let exact = phpSdk.mod(ws, path: lookupModulePath, findUp: false)
    let toml = phpSdk.mod(ws, path: tomlModulePath + "/nested")

    assert(nested.rootPath == lookupModulePath, "find-up returned the wrong legacy module")
    assert(exact.rootPath == lookupModulePath, "exact lookup returned the wrong module")
    assert(toml.rootPath == tomlModulePath, "a farther dagger.json shadowed the nearer dagger-module.toml")
    null
  }

  """
  The client root is the nearest composer.json, except that a module's vendored
  SDK resolves to the module that owns it.
  """
  pub findClientRootCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    let fromModule = phpSdk.findClientRoot(root.asWorkspace(cwd: clientRootModulePath))
    let fromSdk = phpSdk.findClientRoot(root.asWorkspace(cwd: clientRootModulePath + "/sdk"))
    let outside = phpSdk.findClientRoot(root.asWorkspace(cwd: fixtureRoot))

    assert(fromModule == clientRootModulePath, "a module should be its own client root")
    assert(fromSdk == clientRootModulePath, "a vendored SDK should resolve to the module that owns it")
    assert(outside == null, "a directory outside any PHP project should have no client root")
    null
  }

  """
  generateScope seeds a new module into a directory that already holds files:
  the template and the manifest are added, nothing is removed, and the scope
  stays the cwd.
  """
  pub generateNewModuleCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    let generated = phpSdk.generateScope(
      root.asWorkspace(cwd: layeringModulePath),
      isModule: true,
      name: "layering",
      clients: [],
    )
    let changes = generated.directory("/").changes(root)

    assert(cwdOf(generated) == layeringModulePath, "generateScope changed the workspace cwd")
    assert(changes.removedPaths.length == 0, "generateScope removed files that already existed in the scope")
    assert(
      contains(changes.addedPaths, layeringModulePath + "/composer.json"),
      "generateScope did not seed the template into the scope",
    )
    assert(
      contains(changes.addedPaths, layeringModulePath + "/dagger-module.toml"),
      "generateScope did not write the module manifest",
    )
    assert(
      generated.file("dagger-module.toml").contents.contains("+") == false,
      "the module manifest should record the engine version without build metadata",
    )
    null
  }

  """
  generateScope on an existing module changes files under the scope only, not
  one module path deeper, and the scope stays the cwd.

  This needs a module whose codegen actually emits files, so it runs the PHP
  runtime.
  """
  pub generateExistingModuleCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    let generated = phpSdk.generateScope(
      root.asWorkspace(cwd: rootingModulePath),
      isModule: true,
      name: "rooting-app",
      clients: [],
    )
    let changes = generated.directory("/").changes(root)
    let paths = changes.addedPaths + changes.modifiedPaths + changes.removedPaths

    assert(cwdOf(generated) == rootingModulePath, "generateScope changed the workspace cwd")
    assert(changes.addedPaths.length > 0, "generating a PHP module should add files")
    assert(
      paths.filter { path => path.hasPrefix(rootingModulePath + "/") == false }.length == 0,
      "generateScope changed files outside the scope",
    )
    assert(
      paths.filter { path => path.hasPrefix(rootingModulePath + "/" + fixtureRoot) }.length == 0,
      "generated files landed one module path deeper than the scope",
    )
    null
  }

  """
  A scope without a module and without clients is left unchanged.
  """
  pub generateClientScopeCheck(ws: Workspace!): Void @check {
    let root = ws.directory("/")
    let generated = phpSdk.generateScope(
      root.asWorkspace(cwd: layeringModulePath),
      isModule: false,
      name: "layering",
      clients: [],
    )

    assert(cwdOf(generated) == layeringModulePath, "generateScope changed the workspace cwd")
    assert(generated.directory("/").changes(root).isEmpty, "a scope without a module or clients should not change")
    null
  }
}
